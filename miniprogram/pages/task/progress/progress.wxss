/* 顶部 header */
.header {
  width: 100%;
  height: 300rpx; /* 调整高度，让 header 不太高 */
  background: linear-gradient(150deg, #6f4aff, #140043 70%, #fff 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  padding: 30rpx 20rpx; /* 内边距适当缩小 */
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.header-info {
  margin-top: 60rpx; /* 顶部信息稍微上移 */
  color: #fff;
}

.city {
  font-size: 28rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.stats {
  display: flex;
  gap: 60rpx;
  font-size: 36rpx;
  margin-bottom: 20rpx;
}

.stat-item text {
  font-size: 24rpx;
  margin-left: 8rpx;
  opacity: 0.8;
}

.edit-btn {
  margin-top: 15rpx;
  align-self: flex-start;
  font-size: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 50rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.edit-icon {
  font-size: 28rpx;
}

/* 页面容器 */
.page {
  background-color: #f5f5f5;
  padding: 0 10rpx 20rpx 10rpx; /* 减小左右 padding */
  min-height: 100vh;
}

/* Tabs 卡片 */
.tab-card {
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.06);
  margin: -40rpx 20rpx 20rpx 20rpx; /* 上浮覆盖 header 底部圆角 */
  padding: 0;
  overflow: hidden;
  position: relative;
  z-index: 2;
}

.flow-tip-card {
  margin: 0 20rpx 20rpx 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f7fbff;
  border: 1rpx solid #d9ecff;
  box-sizing: border-box;
  overflow: hidden;
  transition: padding 0.28s ease, margin-bottom 0.28s ease, background-color 0.28s ease;
}

.flow-tip-card.collapsed {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  background: #edf6ff;
}

.flow-tip-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0;
}

.flow-tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1976d2;
}

.flow-tip-status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6b8fb6;
}

.flow-tip-body {
  max-height: 1000rpx;
  opacity: 1;
  overflow: hidden;
  transition: max-height 0.32s ease, opacity 0.2s ease, margin-top 0.28s ease;
}

.flow-tip-card.collapsed .flow-tip-body {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
}

.flow-tip-desc {
  display: block;
  font-size: 24rpx;
  color: #5f6b7a;
  line-height: 1.6;
}

/* 课程管理页详细说明：分条写清进入时机、进入结果和下一步操作 */
.flow-guide-row {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.flow-guide-label {
  display: block;
  font-size: 22rpx;
  color: #3f78b5;
}

.flow-guide-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5f6b7a;
  line-height: 1.7;
}

.tab-bar {
  display: flex;
  justify-content: space-around;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0; /* 调整高度 */
  font-size: 26rpx;
  color: #888;
  transition: color 0.3s, border-bottom 0.3s;
}

.tab-item.active {
  color: #1aad19;
  border-bottom: 4rpx solid #1aad19;
  font-weight: 600;
}

/* 任务列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 10rpx;
}

/* 卡片 */
.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.06);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-header .title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: #fff;
  text-align: center;
}

.status-pending {
  background-color: #ff9800;
}

.status-ongoing {
  background-color: #1976d2;
}

.status-completed {
  background-color: #4caf50;
}

.status-cancelled {
  background-color: #f44336;
}

/* 卡片元信息 */
.meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 12rpx;
}

/* 描述 */
.desc {
  font-size: 24rpx;
  color: #444;
  line-height: 34rpx;
  margin-bottom: 12rpx;
}

.flow-tip-inline {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #1976d2;
  line-height: 32rpx;
}

/* 用户信息 */
.user {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user .avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.user-info {
  flex: 1;
}

.user-info .name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.user-info .role {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.contact {
  padding: 5rpx 14rpx;
  background-color: #1aad19;
  color: #fff;
  border-radius: 12rpx;
  font-size: 22rpx;
  text-align: center;
}

/* 操作行 */
.action-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

button.primary {
  flex: 1;
  background-color: #1aad19;
  color: #fff;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  border: none;
}

button.secondary {
  min-width: 220rpx;
  background-color: #fff;
  color: #1976d2;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #b7dcff;
}

.more {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #bbb;
}

.empty .icon {
  font-size: 70rpx;
  margin-bottom: 16rpx;
}
