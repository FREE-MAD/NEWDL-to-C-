.container {
  padding: 30rpx;
  background-color: #f8f9fc;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 80rpx;
}

/* Card Common Styles */
.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.06);
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 0;
  border-bottom: none;
}

.title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 0;
}

/* Status Tags */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: #fff;
  text-align: center;
  display: inline-block;
  font-weight: normal;
}

.status-tag.PENDING { background-color: #ff9800; color: #fff; border: none; }
.status-tag.WAIT_PAYMENT { background-color: #ff9800; color: #fff; border: none; }
.status-tag.PAID { background-color: #2196f3; color: #fff; border: none; }
.status-tag.COACH_READY { background-color: #4caf50; color: #fff; border: none; }
.status-tag.PARENT_CONFIRMED { background-color: #2196f3; color: #fff; border: none; }
.status-tag.COMPLETED_BY_COACH { background-color: #9c27b0; color: #fff; border: none; }
.status-tag.DONE { background-color: #4caf50; color: #fff; border: none; }

/* Info Rows */
.content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-bottom: 0;
}

.label {
  color: #666;
  font-weight: 400;
}

.value {
  color: #444;
  font-weight: 400;
  text-align: right;
  max-width: 70%;
}

.value.highlight {
  color: #1aad19;
  font-weight: 500;
}

/* Action Section */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 0;
}

.section-title::before {
  display: none;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 10rpx;
}

.btn-action {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.btn-action:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.btn-action.primary {
  background-color: #1aad19;
  color: #fff;
}

.btn-action.warn {
  background-color: #f44336;
  color: #fff;
}

.btn-action.finish {
  background-color: #1aad19;
  color: #fff;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 8rpx 0;
  background: transparent;
  border-radius: 0;
}

.hint-text.running {
  color: #2196f3;
  background: transparent;
  font-weight: normal;
  margin-bottom: 10rpx;
  padding: 0;
}

.hint-text.done {
  color: #4caf50;
  background: transparent;
  font-weight: normal;
  padding: 0;
}

/* Media Card */
.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.upload-btn, .edit-btn {
  font-size: 26rpx;
  color: #1890ff;
  padding: 12rpx 24rpx;
  background: #e6f7ff;
  border-radius: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.media-item {
  width: 100%;
  padding-bottom: 100%; /* Square aspect ratio */
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f2f5;
}

.media-item image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.empty-hint {
  grid-column: 1 / -1;
  font-size: 28rpx;
  color: #bfbfbf;
  text-align: center;
  padding: 60rpx 0;
  background: #fafafa;
  border-radius: 12rpx;
  border: 2rpx dashed #eee;
}

/* Summary Card */
.summary-content {
  font-size: 30rpx;
  color: #595959;
  line-height: 1.7;
  min-height: 120rpx;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.modal-container {
  width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.12);
  transform: translateY(0);
  animation: modalFadeIn 0.3s ease;
}

@keyframes modalFadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
  color: #1a1a1a;
}

.modal-textarea {
  width: 100%;
  height: 240rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 40rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.modal-textarea:focus {
  background: #fff;
  border-color: #1890ff;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #1890ff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}