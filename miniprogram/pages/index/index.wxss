}

.resume-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  margin-bottom: 0;
  border-radius: 18rpx;
}

.resume-icon-symbol {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.resume-copy {
  flex: 1;
  min-width: 0;
}

.resume-copy .grid-title {
  color: #2b2f3a;
}

.resume-copy .grid-sub {
  color: #858ba0;
}

.resume-suffix {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #635bff;
  font-size: 24rpx;
  font-weight: 600;
}

.big_view {
  margin-top: 24rpx;
}

.section-title {
  margin: 50rpx 40rpx 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 700;
}

.view-all {
  font-size: 26rpx;
  color: #4b6bff;
}

.post-card {
  margin: 12rpx 40rpx;
  background: #fff;
  padding: 26rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.06);
}

.post-header {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}

.post-time {
  color: #888;
}

.post-tag {
  margin-top: 18rpx;
  background: #fff6c2;
  color: #a67c00;
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.post-text {
  margin-top: 20rpx;
  color: #555;
  font-size: 28rpx;
  line-height: 1.4;
}

.post-img {
  width: 100%;
  height: 300rpx;
  border-radius: 26rpx;
  margin-top: 25rpx;
  object-fit: cover;
}

.post-footer {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
}

.details {
  margin-left: auto;
  color: #4b6bff;
  font-size: 28rpx;
}
