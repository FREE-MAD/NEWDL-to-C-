}

.lesson-picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.lesson-picker-scroll {
  flex: 1;
  white-space: nowrap;
}

.lesson-picker-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  height: 64rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}

.lesson-picker-chip.active {
  background: var(--primary-light);
  color: var(--primary-color);
  font-weight: 600;
}

.new-lesson-btn {
  min-width: 170rpx;
}

.empty-state {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  line-height: 1.7;
}

.footer-spacer {
