/* 全局重置与变量 */
page {
  --primary-color: #1976d2;
  --primary-light: #e3f2fd;
  --text-main: #333333;
  --text-sub: #666666;
  --text-placeholder: #bbbbbb;
  --bg-color: #f7f8fa;
  --card-bg: #ffffff;
  --border-color: #eeeeee;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
}

.status-bar-placeholder {
  width: 100%;
  background-color: #fff;
  flex-shrink: 0;
}

/* Tab 导航 */
.tabs-header {
  display: flex;
  background-color: #fff;
  height: 96rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
  z-index: 100;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-sub);
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-indicator {
  width: 40rpx;
  height: 6rpx;
  background: transparent;
  border-radius: 4rpx;
  margin-top: 8rpx;
}

.tab-item.active .tab-indicator {
  background: var(--primary-color);
}

/* 主滚动区 */
.main-scroll {
  flex: 1;
  background-color: var(--bg-color);
  height: 0;
  width: 100%;
}

/* Banner */
.banner-box {
  padding: 24rpx 32rpx;
}

.banner-content {
  background: linear-gradient(135deg, #e3f2fd, #f0f7ff);
  color: #1565c0;
  font-size: 26rpx;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(25, 118, 210, 0.1);
  line-height: 1.6;
}

.banner-action-btn {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #1976d2;
  border: 2rpx solid #b7dcff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 内容淡入动画 */
.fade-in {
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.content-section {
  padding: 0 32rpx;
}

.course-detail-card,
.section-card,
.empty-state {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

/* 横向滚动 - 课程选择 */
.section-header {
  margin: 40rpx 0 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
  line-height: 1.6;
}

/* 横向滚动区域 */
.class-scroll-view {
  width: 100%;
  white-space: nowrap;
  padding-top: 10rpx;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

/* 单个卡片 */
.class-card {
  display: inline-flex;
  flex-direction: column;
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-left: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
  overflow: hidden;
  white-space: normal;
  vertical-align: top;
}

.class-card.active {
  border-color: #1976d2;
  background-color: #f0f7ff;
  box-shadow: 0 8rpx 24rpx rgba(25, 118, 210, 0.15);
}

/* 卡片主体 */
.class-card-main {
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.class-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #42a5f5, #1976d2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 44rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.class-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.class-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.class-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.4;
}

.class-check {
  margin-left: 16rpx;
}

/* 子选项区域 */
.class-sub-area {
  padding: 24rpx;
  background-color: #fff;
  border-top: 1rpx solid rgba(0,0,0,0.03);
}

.sub-tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sub-tag {
  padding: 12rpx 28rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid transparent;
}

.sub-tag.selected {
  background-color: #e3f2fd;
  color: #1565c0;
  border-color: rgba(25, 118, 210, 0.3);
  font-weight: 500;
}

.scroll-spacer {
  width: 32rpx;
  display: inline-block;
}

/* 课程详情卡片 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.detail-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 24rpx;
  text-align: justify;
}

.detail-imgs {
  white-space: nowrap;
  height: 160rpx;
}

.detail-img {
  width: 240rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background-color: #eee;
}

/* 表单样式 */
.form-container {
  padding-bottom: 20rpx;
}

.create-group-card {
  border: 2rpx solid #e8eef8;
  box-shadow: none;
}

.private-form-card {
  background: #fcfcff;
  border: 1rpx solid #e8f0ff;
}

.group-subtitle {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.group-inner-card {
  margin-bottom: 32rpx;
  background: #fafcff;
  box-shadow: none;
  border: 1rpx solid #eef4ff;
}

.agreement-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fffaf0;
  border: 1rpx solid #ffe7ba;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.agreement-text {
  flex: 1;
}

.agreement-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
}

.agreement-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.form-group,
.form-item {
  margin-bottom: 32rpx;
}

.form-group.no-margin,
.private-switch-row.no-margin {
  margin-bottom: 0;
}

.choice-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.choice-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #d9e7ff;
  background: #fff;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-main);
}

.choice-chip.active {
  background: #f0f7ff;
  border-color: #91caff;
  color: #1976d2;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 16rpx;
  font-weight: 600;
  display: block;
}

.form-label.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 6rpx;
}

.form-label.no-margin {
  margin-bottom: 0;
}

.form-input-box,
.form-input {
  width: 100%;
  min-height: 96rpx;
  background: #fff;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--text-main);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-input-box {
  height: auto;
  padding: 24rpx;
  line-height: 1.4;
}

.form-input {
  height: 96rpx;
}

.form-textarea,
.summary-textarea {
  width: 100%;
  min-height: 220rpx;
  background: #fff;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.input-placeholder {
  color: var(--text-placeholder);
}

.input-val {
  color: var(--text-main);
}

.input-icon {
  color: #999;
  margin-left: 16rpx;
}

.create-actions,
.manage-actions,
.manage-lesson-actions,
.modal-footer {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn-submit,
.btn-secondary,
.manage-btn,
.mini-btn,
.btn-cancel {
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-submit,
.modal-submit {
  background: linear-gradient(135deg, #1976d2, #1565c0);
  color: #fff;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 10rpx 20rpx rgba(21, 101, 192, 0.3);
}

.create-submit {
  flex: 1;
  width: auto;
}

.btn-secondary,
.manage-btn,
.mini-btn.ghost,
.btn-cancel {
  background: #fff;
  color: #1976d2;
  border: 2rpx solid #b7dcff;
}

.btn-secondary {
  width: 220rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.manage-actions {
  margin-bottom: 24rpx;
}

.manage-btn {
  min-width: 180rpx;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 24rpx;
}

.manage-btn.ghost {
  color: #666;
  border-color: #ddd;
}

.section-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.section-card-title.minor {
  font-size: 26rpx;
  margin-top: 24rpx;
}

.sync-tip,
.sync-note {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.sync-note.no-margin {
  margin-bottom: 0;
}

.manage-lesson-item {
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.manage-lesson-item.selected,
.selected-lesson-panel {
  border: 2rpx solid #b7dcff;
  background: #f7fbff;
  border-radius: 16rpx;
}

.history-summary-item {
  background: #fafafa;
  border-style: dashed;
}

.selected-lesson-panel {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.manage-lesson-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.manage-lesson-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.manage-lesson-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
}

.manage-lesson-status.PENDING {
  background: #fff7e6;
  color: #fa8c16;
}

.manage-lesson-status.PARENT_CONFIRMED,
.manage-lesson-status.COACH_READY {
  background: #e6f7ff;
  color: #1890ff;
}

.manage-lesson-status.DONE {
  background: #f6ffed;
  color: #52c41a;
}

.manage-lesson-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.mini-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.mini-btn.finish {
  background: #52c41a;
  color: #fff;
}

.summary-lessons {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.summary-lesson-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  height: 64rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}

.summary-lesson-chip.active {
  background: var(--primary-light);
  color: var(--primary-color);
  font-weight: 600;
}

.summary-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.summary-time-grid {
  margin-bottom: 8rpx;
}

.summary-time-tip {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.private-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.private-switch-text {
  flex: 1;
}

.private-switch-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.lesson-picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.lesson-picker-scroll {
  flex: 1;
  white-space: nowrap;
}

.lesson-picker-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  height: 64rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}

.lesson-picker-chip.active {
  background: var(--primary-light);
  color: var(--primary-color);
  font-weight: 600;
}

.new-lesson-btn {
  min-width: 170rpx;
}

.empty-state {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  line-height: 1.7;
}

.footer-spacer {
  height: 100rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.modal-container {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.small-modal-container {
  max-width: 620rpx;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-content {
  padding: 30rpx;
}

.modal-footer {
  padding: 24rpx 30rpx 30rpx;
}

.btn-cancel,
.modal-submit {
  flex: 1;
  width: auto;
  height: 88rpx;
  line-height: 88rpx;
}

/* Loading Mask */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.9);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--primary-light);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
