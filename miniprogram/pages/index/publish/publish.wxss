/* pages/index/publish/publish.wxss */
.publish-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f7fb;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.tool-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tool-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.tool-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.tool-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.tool-arrow {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #07c160;
}
