<!-- pages/profile/edit/edit.wxml -->
<view class="container">
  <form bindsubmit="onSave">
    <!-- 头像 -->
    <view class="form-section">
      <view class="section-title">头像</view>
      <view class="avatar-container" bindtap="onChooseAvatar">
        <image 
          class="avatar" 
          src="{{profile.avatar || '/images/default-avatar.png'}}"
          mode="aspectFill"
        />
        <view class="avatar-edit">
          <text>点击更换</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-section">
      <view class="section-title">基本信息</view>
      
      <view class="form-item">
        <text class="label">昵称</text>
        <input 
          class="input" 
          value="{{profile.nickname}}"
          data-field="nickname"
          bindinput="onInput"
          placeholder="请输入昵称"
        />
      </view>

      <view class="form-item">
        <text class="label">性别</text>
        <radio-group bindchange="onGenderChange">
          <label class="radio-item">
            <radio value="1" checked="{{profile.gender === 1}}" color="#007AFF"/>
            <text>男</text>
          </label>
          <label class="radio-item">
            <radio value="2" checked="{{profile.gender === 2}}" color="#007AFF"/>
            <text>女</text>
          </label>
        </radio-group>
      </view>

      <view class="form-item">
        <text class="label">年龄</text>
        <input 
          class="input" 
          type="number"
          value="{{profile.age}}"
          data-field="age"
          bindinput="onInput"
          placeholder="请输入年龄"
        />
      </view>

      <view class="form-item">
        <text class="label">身高(cm)</text>
        <input 
          class="input" 
          type="number"
          value="{{profile.height}}"
          data-field="height"
          bindinput="onInput"
          placeholder="请输入身高"
        />
      </view>

      <view class="form-item">
        <text class="label">体重(kg)</text>
        <input 
          class="input" 
          type="number"
          value="{{profile.weight}}"
          data-field="weight"
          bindinput="onInput"
          placeholder="请输入体重"
        />
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="form-section">
      <view class="section-title">联系方式</view>
      
      <view class="form-item">
        <text class="label">手机号</text>
        <input 
          class="input" 
          value="{{profile.phone}}"
          data-field="phone"
          bindinput="onInput"
          placeholder="请输入手机号"
        />
      </view>

      <view class="form-item">
        <text class="label">邮箱</text>
        <input 
          class="input" 
          value="{{profile.email}}"
          data-field="email"
          bindinput="onInput"
          placeholder="请输入邮箱"
        />
      </view>

      <view class="form-item">
        <text class="label">位置</text>
        <view class="location-picker" bindtap="onLocationChoose">
          <text class="location-text">{{profile.location || '请选择位置'}}</text>
          <text class="location-arrow">></text>
        </view>
      </view>
    </view>

    <!-- 运动爱好 -->
    <view class="form-section">
      <view class="section-title">运动爱好</view>
      <checkbox-group bindchange="onSportChange">
        <view class="sport-list">
          <label 
            wx:for="{{sportOptions}}" 
            wx:key="value"
            class="sport-item"
          >
            <checkbox value="{{item.value}}" checked="{{profile.sports.includes(item.value)}}" color="#007AFF"/>
            <text>{{item.name}}</text>
          </label>
        </view>
      </checkbox-group>
    </view>

    <!-- 个人简介 -->
    <view class="form-section">
      <view class="section-title">个人简介</view>
      <textarea 
        class="textarea"
        value="{{profile.bio}}"
        data-field="bio"
        bindinput="onInput"
        placeholder="介绍一下自己吧..."
        maxlength="200"
      />
      <view class="char-count">{{profile.bio.length}}/200</view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-section">
      <button class="save-btn" form-type="submit">保存资料</button>
    </view>
  </form>
</view>