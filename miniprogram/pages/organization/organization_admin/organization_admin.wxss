/* pages/organization/organization_admin/organization_admin.wxss */
/* 团队管理页（2026-09-21 新建）：配色与机构首页 entry-section 保持一致（海军蓝 + 蓝CTA + 白卡） */

.org-admin-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f7fb;
}

.admin-hero {
  padding: 34rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #153ea8 0%, #1457ff 52%, #45a4ff 100%);
  box-shadow: 0 18rpx 40rpx rgba(20, 87, 255, 0.2);
  color: #ffffff;
}

.admin-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  font-weight: 600;
}

.admin-title {
  margin-top: 22rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.admin-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.94);
}

/* 邀请码行：整行可点击复制 */
.admin-invite-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.admin-invite-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.admin-invite-code {
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.admin-invite-copy {
  margin-left: auto;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  font-size: 22rpx;
  font-weight: 600;
}

/* 加载中 / 无权限状态卡 */
.admin-state-card {
  padding: 40rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.06);
}

.admin-state-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4b5563;
}

.admin-state-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 220rpx;
  height: 72rpx;
  margin-top: 26rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1457ff 0%, #2896ff 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.admin-section {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.06);
}

.admin-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.admin-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.admin-section-count {
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1457ff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.admin-section-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #667085;
}

.admin-empty {
  margin-top: 20rpx;
  padding: 34rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  font-size: 26rpx;
  color: #8a94a6;
  text-align: center;
}

/* 待确认申请卡片 */
.apply-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  background: #fff7ed;
  border: 2rpx solid #fed7aa;
}

.apply-avatar {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #eef4ff;
}

.apply-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8a94a6;
}

.apply-main {
  flex: 1;
  min-width: 0;
}

.apply-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.apply-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4b5563;
}

.apply-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.apply-btn {
  min-width: 148rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.apply-btn-approve {
  background: linear-gradient(135deg, #1457ff 0%, #2896ff 100%);
  color: #ffffff;
}

.apply-btn-reject {
  background: #fdecef;
  color: #d9485f;
}

.apply-btn.disabled {
  opacity: 0.55;
}

/* 团队成员行 */
.member-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
}

.member-avatar {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #eef4ff;
}

.member-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #536075;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.member-role {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1457ff;
  font-size: 22rpx;
  font-weight: 600;
}

.member-role-admin {
  background: #eaf7ef;
  color: #0f9f4f;
}

.member-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #667085;
}
