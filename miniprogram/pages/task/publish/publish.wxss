/* 全局重置与变量 */
page {
  --primary-color: #1976d2;
  --primary-light: #e3f2fd;
  --text-main: #333333;
  --text-sub: #666666;
  --text-placeholder: #bbbbbb;
  --bg-color: #f7f8fa;
  --card-bg: #ffffff;
  --border-color: #eeeeee;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
}

.status-bar-placeholder {
  width: 100%;
  background-color: #fff;
  flex-shrink: 0;
}

/* Tab 导航 */
.tabs-header {
  display: flex;
  background-color: #fff;
  height: 96rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
  z-index: 100;
  position: relative;
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-sub);
  position: relative;
  transition: all 0.3s ease;
}

/* 新增真机页签收口：窄屏设备上避免标题互相挤压，保证点击区和文字都更稳定 */
.tab-item text {
  max-width: 100%;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.disabled {
  opacity: 0.45;
}

.tab-indicator {
  width: 40rpx;
  height: 6rpx;
  background: transparent;
  border-radius: 4rpx;
  margin-top: 8rpx;
}

.tab-item.active .tab-indicator {
  background: var(--primary-color);
}

/* 主滚动区 */
.main-scroll {
  flex: 1;
  background-color: var(--bg-color);
  height: 0;
  width: 100%;
}

/* Banner */
.banner-box {
  padding: 24rpx 32rpx;
  margin: 24rpx 32rpx 0;
  border: 2rpx solid #d9e7ff;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
  transition: padding 0.3s ease, background-color 0.3s ease;
}

.banner-box.collapsed {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  background: #f8fbff;
}

.banner-box-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0;
}

.banner-box-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1565c0;
}

.banner-box-status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7a8ca5;
}

.banner-box-body {
  max-height: 1600rpx;
  opacity: 1;
  overflow: hidden;
  transition: max-height 0.32s ease, opacity 0.2s ease, margin-top 0.28s ease;
}

.banner-box.collapsed .banner-box-body {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
}

.banner-content {
  background: linear-gradient(135deg, #e3f2fd, #f0f7ff);
  color: #1565c0;
  font-size: 26rpx;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(25, 118, 210, 0.1);
  line-height: 1.6;
  margin-top: 20rpx;
}

/* 创建课程页详细说明：使用标题+分行描述，减少用户理解成本 */
.guide-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1257b3;
  margin-bottom: 18rpx;
}

.guide-row {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.guide-row + .guide-row {
  margin-top: 14rpx;
}

.guide-label {
  display: block;
  font-size: 22rpx;
  color: #4f79a5;
}

.guide-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1565c0;
  line-height: 1.7;
}

.banner-tip {
  display: block;
  margin-top: 12rpx;
  color: #d46b08;
}

/* 新增重要操作块：即使顶部说明收起后，也继续突出“家长展示页”这个下一步入口 */
.banner-important-action {
  margin-top: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff7e6, #fffdf7);
  border: 2rpx solid #ffd591;
}

.banner-action-btn {
  margin-top: 16rpx;
  width: 100%;
  display: block;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #1976d2;
  border: 2rpx solid #b7dcff;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.banner-box.collapsed .banner-action-btn {
  margin-top: 14rpx;
}

.banner-action-tip {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #ad4e00;
  font-weight: 600;
}

/* 新增 publish 角色说明卡：把当前是谁、可做什么、不可做什么直接写在页面上，减少混权误操作 */
.publish-role-card {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}

.publish-role-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1565c0;
}

.publish-role-row {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f7fbff;
}

.publish-role-label {
  display: block;
  font-size: 22rpx;
  color: #4f79a5;
}

.publish-role-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #31455a;
}

/* 内容淡入动画 */
.fade-in {
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.content-section {
  padding: 0 32rpx;
}

.course-detail-card,
.section-card,
.empty-state {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

/* 协作辅助块：已降级为"快速参考已有协作单"的旁路引导，而非 B 约课主入口。
   视觉策略：更淡的底色、更弱的虚线边框、标题字重/配色压一级、副标题灰字多行引用块，
   让用户扫一眼就感觉"这里是辅助区，主操作在下面/另一个页面"。 */
.collaboration-card-hint {
  margin-top: 32rpx;
  margin-bottom: 12rpx;
  background: #fafbfd;
  border: 2rpx dashed #dcdfe6;
  border-radius: 24rpx;
  box-shadow: none;
}

.collaboration-title-hint {
  font-size: 30rpx;
  font-weight: 600;
  color: #5a6170;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.collaboration-title-icon {
  color: #a0a8b8;
  font-size: 26rpx;
}

/* 主流程建议副标题：左侧用一个 "›" 蓝灰竖线色块做引用效果，降低标题的视觉权重。 */
.collaboration-subtitle-hint {
  margin-top: 18rpx;
  padding: 20rpx 20rpx 20rpx 20rpx;
  border-radius: 18rpx;
  background: #eef0f5;
  border-left: 8rpx solid #b7bfcd;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.collaboration-subtitle-bullet {
  flex-shrink: 0;
  margin-right: 4rpx;
  color: #8a919f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.collaboration-subtitle-text {
  color: #6a7180;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 主流程推荐跳转行：把 progress/班级管理 的入口做成突出浅蓝按钮，
   用户一进页面第一眼就被引导去"正确的主流程"，而不是先去填协作码。 */
.collaboration-quick-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pickup-code-final-row {
  border: 2rpx dashed rgba(25, 118, 210, 0.18);
}

.pickup-final-code {
  color: #2e7d32;
}

.pickup-readonly-tip {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f7fbff;
  color: #5c6b7a;
  font-size: 24rpx;
  line-height: 1.6;
}

.collaboration-quick-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #eaf2ff, #d6e4ff);
  color: #1f5fd8;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #c5d6fb;
  line-height: 1.2;
}

.collaboration-quick-tip {
  color: #8a919f;
  font-size: 22rpx;
  line-height: 1.4;
}

/* 分隔线：告诉用户"下面才是可选的参考入口"，用灰字 + 左右横线弱化。 */
.collaboration-divider-hint {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #a0a8b8;
}

.collaboration-divider-hint::before,
.collaboration-divider-hint::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #e3e6ec;
  display: block;
}

.collaboration-divider-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #a0a8b8;
}

/* 协作码输入框弱化为辅助区：不再是蓝色实线的"主要表单"感。 */
.collaboration-code-input {
  background: #f5f6f9;
  border: 2rpx solid #e5e8ef;
  color: #4a5060;
}

/* 次级按钮"参考该协作单"：降为重灰 + 文字按钮风，避免与上方主流程浅蓝按钮抢 CTA。 */
.collaboration-fetch-btn-hint {
  background: #ffffff;
  color: #6a7180;
  border: 2rpx solid #d9dde5;
  font-weight: 500;
  box-shadow: none;
}

.collaboration-fetch-btn-hint[disabled],
.collaboration-fetch-btn-hint[disabled]:active {
  background: #f1f2f5 !important;
  color: #98a0ad !important;
  border-color: #e5e8ef !important;
}

/* 新增：协作卡片锁定态 (导入后 / 编辑态)：背景整体变淡，视觉提示"只看不改" */
.collaboration-card-locked {
  background: #fafafa;
  border-color: #e0e3e8;
}

/* 新增：标题行旁边的"已锁定"小标签，明确告知用户为什么输入框点不进去 */
.section-card-tag-locked {
  display: inline-block;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eef0f3;
  color: #8a9099;
  font-size: 22rpx;
  font-weight: 500;
  vertical-align: middle;
}

.collaboration-input-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* 新增：锁定态整行置灰，并进一步限制 pointer 事件，减少误触路径 */
.collaboration-input-row-locked {
  opacity: 0.85;
  pointer-events: none;
}

/* 新增：锁定态输入框样式切为"只读展示条"：浅灰底 + 灰字 + 禁用光标态 */
.collaboration-code-input-locked {
  background: #f2f3f5;
  color: #6a7180;
  caret-color: transparent;
  cursor: not-allowed;
}

.collaboration-fetch-btn {
  flex-shrink: 0;
  min-width: 260rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 新增：锁定态按钮切为"已导入"灰色按钮，和主操作做视觉区分 */
.collaboration-fetch-btn-locked {
  background: #d9dde2 !important;
  color: #6a7180 !important;
  border: 2rpx solid #e0e3e8;
  font-weight: 500;
}

.collaboration-preview {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fafbff;
  border: 2rpx solid #dfe6f8;
}

/* 新增：已有课程编辑态的只读协作摘要，配色比导入态更淡，强调"历史数据"性质 */
.collaboration-preview-readonly {
  background: #fafafa;
  border-color: #e6e8ec;
}

.collaboration-preview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #556fc2;
}

.collaboration-preview-item,
.collaboration-preview-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4d5b76;
}

.collaboration-preview-tip {
  color: #666;
}

/* 横向滚动 - 课程选择 */
.section-header {
  margin: 40rpx 0 24rpx;
}

/* 新增课节管理头部卡片：把标题和说明提示统一收进同一个外边框容器 */
.manage-header-card {
  margin: 40rpx 0 24rpx;
  padding: 24rpx;
  border: 2rpx solid #e8eef8;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.manage-section-header {
  margin: 0 0 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
  line-height: 1.6;
}

/* 横向滚动区域 */
.class-scroll-view {
  width: 100%;
  white-space: nowrap;
  padding-top: 10rpx;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

/* 单个卡片 */
.class-card {
  display: inline-flex;
  flex-direction: column;
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-left: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
  overflow: hidden;
  white-space: normal;
  vertical-align: top;
}

.class-card.active {
  border-color: #1976d2;
  background-color: #f0f7ff;
  box-shadow: 0 8rpx 24rpx rgba(25, 118, 210, 0.15);
}

/* 卡片主体 */
.class-card-main {
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.class-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #42a5f5, #1976d2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 44rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.class-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.class-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.class-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.4;
}

.class-check {
  margin-left: 16rpx;
}

/* 子选项区域 */
.class-sub-area {
  padding: 24rpx;
  background-color: #fff;
  border-top: 1rpx solid rgba(0,0,0,0.03);
}

.sub-tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sub-tag {
  padding: 12rpx 28rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid transparent;
}

.sub-tag.selected {
  background-color: #e3f2fd;
  color: #1565c0;
  border-color: rgba(25, 118, 210, 0.3);
  font-weight: 500;
}

.scroll-spacer {
  width: 32rpx;
  display: inline-block;
}

/* 课程详情卡片 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.detail-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 24rpx;
  text-align: justify;
}

.detail-edit-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #fff;
  border: 2rpx solid #d9e7ff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
}

.detail-imgs {
  white-space: nowrap;
  height: 160rpx;
}

.detail-img {
  width: 240rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background-color: #eee;
}

/* 表单样式 */
.form-container {
  padding-bottom: 20rpx;
}

.create-group-card {
  border: 2rpx solid #e8eef8;
  box-shadow: none;
}

.private-form-card {
  background: #fcfcff;
  border: 1rpx solid #e8f0ff;
}

.group-subtitle {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.group-inner-card {
  margin-bottom: 32rpx;
  background: #fafcff;
  box-shadow: none;
  border: 1rpx solid #eef4ff;
}

.child-profile-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fafcff;
  border: 1rpx solid #e8f0ff;
  margin-bottom: 24rpx;
}

.child-profile-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.child-profile-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.child-profile-remove {
  font-size: 24rpx;
  color: #ff4d4f;
}

.child-profile-add {
  min-height: 84rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #91caff;
  background: #f7fbff;
  color: #1976d2;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.agreement-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fffaf0;
  border: 1rpx solid #ffe7ba;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.agreement-text {
  flex: 1;
}

.agreement-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
}

.agreement-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.form-group,
.form-item {
  margin-bottom: 32rpx;
}

.form-group.no-margin,
.private-switch-row.no-margin {
  margin-bottom: 0;
}

.choice-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.choice-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #d9e7ff;
  background: #fff;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-main);
}

.choice-chip.active {
  background: #f0f7ff;
  border-color: #91caff;
  color: #1976d2;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-main);
