<view class="page">
<!-- 常驻状态====== -->
  <!-- 常驻状态（仅在登录后显示） -->
  <view class="header collapsed">
    <!-- 首页欢迎区新样式：补充顶部胶囊按钮和右侧装饰，让首页第一屏更有引导感 -->
    <view class="header-topbar">
      <view class="header-left">
        <!-- 首页新增业务模式标签：让用户一眼知道自己当前走的是哪条工作流 -->
        <view class="mode-badges">
          <view class="mode-badge">{{bizRoleLabel}}</view>
          <view wx:if="{{orgName}}" class="mode-badge org-name-badge">{{orgName}}</view>
        </view>
        <view class="hello"> {{welcome}} 👋</view>
        <view class="header-desc">{{headerDesc}}</view>
      </view>
    </view>

  </view>

<!-- 首页入口新布局：第1项作为核心按钮，第2/3项合并为教练简历分组 -->
<view wx:if="{{panelItems.length >= 3}}" class="grid-box" style="width: 689rpx;">
  <!-- 首页新增快捷入口：补一个"低价办证"卡片，方便用户直接进入办证页 -->
  <view class="grid-item visible certification-entry" bindtap="goToDoCertification">
    <view class="certification-entry-main">
      <view class="icon red certification-entry-icon">
        <text class="grid-icon-symbol">证</text>
      </view>
      <view class="certification-entry-copy">
        <view class="grid-title">低价办证</view>
        <view class="grid-sub">点击进入办证页面，查看办理说明</view>
      </view>
      <view class="certification-entry-arrow">立即查看 ></view>
    </view>
    <!-- 首页新增办证轮播：直接轮播云存储海报，让用户进入前先看到实际宣传图 -->
    <swiper
      class="certification-swiper"
      indicator-dots="{{true}}"
      autoplay="{{true}}"
      circular="{{true}}"
      interval="2800"
      duration="450"
    >
      <swiper-item wx:for="{{certificationBanners}}" wx:key="image">
        <view class="certification-swiper-item" bindtap="goToDoCertification">
          <!-- 首页办证卡片改为轮播云存储海报：用户直接看图，更容易一眼理解入口内容 -->
          <image
            class="certification-swiper-image"
            src="{{item.image}}"
            mode="aspectFill"
          />
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 首页新增：教练接取课程入口卡片。
       - 任何登录/未登录用户都能看到入口；
       - 点击标题展开接取码输入框，支持粘贴 + 一键清空；
       - 未登录（访客）点击提交会引导去完善教练资料；
       - 成功接取后在下方显示课程信息，提供直接「进入课程管理」按钮。 -->
  <!-- 【2026-09-16 新增·新码制】接取码改为 10 位（8 课程码 + 2 位状态后缀 pl/ip/dl，如 ABCD1234pl）；
       旧 12 位随机码兼容仍保留（maxlength=12 兼容 10/12 两种长度），文案更新为新码格式。 -->
  <view class="pickup-entry-card visible">
    <view class="pickup-entry-head" bindtap="togglePickupPanel">
      <view class="pickup-entry-left">
        <view class="icon green pickup-entry-icon">
          <text class="grid-icon-symbol">接</text>
        </view>
        <view class="pickup-entry-copy">
          <view class="grid-title pickup-entry-title">接取课程</view>
          <view class="grid-sub">拿到接取码（课程码+pl，10 位），在这里输入即可开始带课</view>
        </view>
      </view>
      <view class="pickup-entry-arrow">{{showPickupPanel ? ' ∧' : ' ∨'}}</view>
    </view>

    <view wx:if="{{showPickupPanel}}" class="pickup-entry-body">
      <view class="pickup-entry-hint">
        新码 = 课程码(8 位) + 状态后缀 pl(2 位)，共 10 位英数字，如 ABCD1234pl；旧 12 位随机码仍可输入；无需区分大小写。
      </view>
      <view class="pickup-entry-input-row">
        <!-- 输入框外层容器：负责在 flex 布局中占满剩余宽度，
             小程序原生 input 直接设 flex:1 不可靠，需包一层 view -->
        <view class="pickup-entry-input-wrap">
          <input
            class="pickup-entry-input"
            placeholder="请输入或粘贴接取码（课程码+pl，10 位）"
            placeholder-class="pickup-entry-input-placeholder"
            value="{{pickupCodeInput}}"
            bindinput="onPickupCodeInput"
            maxlength="12"
            confirm-type="done"
            bindconfirm="submitPickupCode"
          />
        </view>
        <view class="pickup-entry-quick-btns">
          <button class="pickup-entry-mini" catchtap="pastePickupCode">粘贴</button>
          <button class="pickup-entry-mini" catchtap="clearPickupCode">清空</button>
        </view>
      </view>
      <view class="pickup-entry-char-hint">
        已输入 <text class="pickup-entry-char-num">{{pickupCodeInput.length}}</text> / 10 位（旧码 12 位）
      </view>

      <button
        class="pickup-entry-submit {{(pickupCodeInput.length === 10 || pickupCodeInput.length === 12) ? '' : 'pickup-entry-submit-disabled'}}"
        bindtap="submitPickupCode"
        loading="{{isSubmittingPickup}}"
        disabled="{{isSubmittingPickup}}"
      >立即接取这门课程</button>

      <!-- 接取成功摘要：展示课程名、地点、教练名并直接跳转进课程管理 -->
      <view wx:if="{{pickupLastResult && pickupLastResult.ok}}" class="pickup-entry-result pickup-entry-result-ok">
        <view class="pickup-result-title">🎉 {{pickupLastResult.msg}}{{pickupLastResult.alreadyAssigned ? '（已接取过）' : ''}}</view>
        <view wx:if="{{pickupLastResult.title}}" class="pickup-result-row">课程：{{pickupLastResult.title}}</view>
        <view wx:if="{{pickupLastResult.location}}" class="pickup-result-row">地点：{{pickupLastResult.location}}</view>
        <view wx:if="{{pickupLastResult.coachName}}" class="pickup-result-row">执行教练：{{pickupLastResult.coachName}}</view>
        <view wx:if="{{pickupLastResult.pickupFinalCode}}" class="pickup-result-row">确认码：{{pickupLastResult.pickupFinalCode}}</view>
        <!-- 【2026-09-21 新流程】pending = 绑定申请已提交、等待管理者确认，此时没有 orderId，
             隐藏「进入课程管理」按钮，避免点下去只弹「缺少课程ID」。 -->
        <view wx:if="{{pickupLastResult.pending}}" class="pickup-result-row">
          申请已提交，请等待管理者确认后即可开始带课。
        </view>
        <view wx:if="{{!pickupLastResult.pending}}" class="pickup-result-actions">
          <button class="pickup-result-btn" bindtap="goToPickedUpCourse">进入课程开始管理</button>
          <button class="pickup-result-btn pickup-result-btn-sub" catchtap="togglePickupPanel">先收起面板</button>
        </view>
      </view>

      <!-- 接取失败摘要：直接把原因显示在面板下，减少用户反复点 toast -->
      <view wx:if="{{pickupLastResult && !pickupLastResult.ok}}" class="pickup-entry-result pickup-entry-result-fail">
        <view class="pickup-result-title pickup-result-title-fail">⚠ 接取未通过</view>
        <view class="pickup-result-row">原因：{{pickupLastResult.msg}}</view>
      </view>
    </view>
  </view>

  <view
    class="primary-panel visible"
    bindtap="onPanelTap"
    data-action="{{panelItems[0].action}}"
  >
    <view class="panel-chip">核心功能</view>
    <view class="panel-main">
      <!-- 首页主卡片图标：保留纯样式实现，避免引入额外图片资源 -->
      <view class="icon {{panelItems[0].color}} primary-icon">
        <text class="primary-icon-symbol">+</text>
      </view>
      <view class="primary-copy">
        <view class="grid-title primary-title">{{panelItems[0].title}}</view>
        <view class="grid-sub primary-sub">{{panelItems[0].sub}}</view>
      </view>
    </view>

    <!-- 首页主入口详细说明：直接解释为什么要创建班级，以及创建后可以继续做什么 -->
    <view class="primary-detail-list">
      <view
        wx:for="{{primaryGuideList}}"
        wx:for-item="guide"
        wx:key="label"
        class="primary-detail-item"
      >
        <view class="primary-detail-icon">{{index === 0 ? '?' : '+'}}</view>
        <view class="primary-detail-copy">
          <view class="primary-detail-label">{{guide.label}}</view>
          <view class="primary-detail-value">{{guide.value}}</view>
        </view>
      </view>
    </view>

    <view class="panel-arrow">
      <text>{{primaryActionText}}</text>
      <text class="panel-arrow-icon">›</text>
    </view>

        <!-- 首页主入口补充兜底跳转：给想直接去课程管理的用户一个单独小箭头入口 -->
        <view class="primary-manage-shortcut" catchtap="goToCourseManage">
          <text class="primary-manage-shortcut-text">{{primaryShortcutText}}</text>
      <text class="primary-manage-shortcut-arrow">›</text>
        </view>
  </view>

  <!-- 教练简历分组固定内容：文案和入口都取最初的访客口径，不随业务角色变化 -->
  <view class="resume-group visible">
    <view class="resume-group-head">
      <view class="resume-group-title">教练简历</view>
      <view class="resume-group-sub">{{resumeGroupSub}}</view>
    </view>

    <view
      class="resume-item"
      bindtap="onPanelTap"
      data-action="{{resumeItems[0].action}}"
    >
      <view class="resume-item-left">
        <view class="icon {{resumeItems[0].color}} resume-icon">
          <text class="resume-icon-symbol">资</text>
        </view>
        <view class="resume-copy">
          <view class="grid-title">{{resumeItems[0].title}}</view>
          <view class="grid-sub">{{resumeItems[0].sub}}</view>
        </view>
      </view>
      <view class="resume-suffix">去完善</view>
    </view>

    <view
      class="resume-item"
      bindtap="onPanelTap"
      data-action="{{resumeItems[1].action}}"
    >
      <view class="resume-item-left">
        <view class="icon {{resumeItems[1].color}} resume-icon">
          <text class="resume-icon-symbol">预</text>
        </view>
        <view class="resume-copy">
          <view class="grid-title">{{resumeItems[1].title}}</view>
          <view class="grid-sub">{{resumeItems[1].sub}}</view>
        </view>
      </view>
      <view class="resume-suffix">去查看</view>
    </view>
  </view>
</view>
</view>
