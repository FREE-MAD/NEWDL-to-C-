/* pages/train/plan/plan.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.tab-section {
  background: white;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab-bar {
  display: flex;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #007AFF;
  background: #f0f8ff;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #007AFF;
  border-radius: 2rpx;
}

.category-section {
  background: white;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 20rpx;
  background: #f0f0f0;
}

.category-item.active {
  background: #007AFF;
  color: white;
}

.plan-list {
  padding: 0 10rpx;
}

.plan-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.plan-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.plan-difficulty {
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(0,122,255,0.1);
}

.plan-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.plan-duration, .plan-frequency, .plan-calories {
  font-size: 24rpx;
  color: #666;
  background: #f8f9fa;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.plan-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.exercises-preview {
  margin-bottom: 16rpx;
}

.exercises-title {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.exercises-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.exercise-tag {
  font-size: 24rpx;
  color: #007AFF;
  background: #e3f2fd;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.plan-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.plan-author {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.author-name {
  font-size: 24rpx;
  color: #666;
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  min-width: 120rpx;
  height: 64rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.detail-btn {
  background: #007AFF;
  color: white;
}

.start-btn {
  background: #4CAF50;
  color: white;
}

.edit-btn {
  background: #FF9800;
  color: white;
}

.adopt-btn {
  background: #9C27B0;
  color: white;
}

.delete-btn {
  background: #f44336;
  color: white;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.fab-button {
  position: fixed;
  bottom: 120rpx;
  right: 30rpx;
  width: 120rpx;
  height: 120rpx;
  background: #007AFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,122,255,0.3);
  z-index: 1000;
}

.fab-icon {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
}