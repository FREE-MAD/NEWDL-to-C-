<view class="page">
  <view class="header">
  <view class="header-info">
    <!-- 课程管理页新增模式标签：先告诉用户自己当前正在看哪条业务线 -->
    <view class="mode-line">
      <text class="mode-pill">{{bizRoleLabel}}</text>
      <text wx:if="{{orgName}}" class="mode-pill mode-org-pill">{{orgName}}</text>
    </view>
    <view class="city">{{bizRole === 'org_coach' ? '专注执行课程' : '把课程安排看得更清楚'}}</view>

    <view class="stats">
      
    </view>

    <view class="edit-btn">
      {{bizRole === 'org_coach' ? '查看待执行课程' : '查看课程进度'}}
      <text class="edit-icon">✎</text>
    </view>
  </view>
</view>

<!-- Tabs -->
<view class="tab-card">
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:for-item="item"
      wx:for-index="index"
      wx:key="status"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>
</view>

    <!-- 新增操作说明：直接说明课程管理页展示什么，以及两个操作入口分别负责什么 -->
<view class="flow-tip-card {{showFlowTipCard ? '' : 'collapsed'}}">
  <!-- 新增标题栏点击展开/收起：默认 5 秒自动收起，收起后仍可点标题重新展开 -->
  <view class="flow-tip-header" bindtap="toggleFlowTipCard">
    <text class="flow-tip-title">课程管理页面说明</text>
    <text class="flow-tip-status">{{showFlowTipCard ? '默认5秒收起' : '点击展开'}}</text>
  </view>
  <!-- 课程管理说明内容：展开时完整显示，5 秒后切到折叠态而不是直接移除 -->
  <view class="flow-tip-body">
    <view class="flow-guide-row" wx:for="{{flowGuideRows}}" wx:key="label">
      <text class="flow-guide-label">{{item.label}}</text>
      <text class="flow-guide-value">{{item.value}}</text>
    </view>
  </view>
</view>

<!-- Task List -->
<view class="list">

  <view
    wx:for="{{tasks}}"
    wx:for-item="item"
    wx:key="id"
    class="card"
  >

    <!-- Header -->
    <view class="card-header">
      <text class="title">{{item.title}}</text>
      <view class="status status-{{item.status}}">
        {{item.statusText}}
      </view>
    </view>

    <!-- Meta -->
    <view class="meta">
      <text>{{item.category}}</text>
      <text>📍 {{item.location}}</text>
      <text>进度 {{item.progressText}}</text>
    </view>

    <view class="meta meta-secondary" wx:if="{{item.courseOwnerText || item.courseTagText}}">
      <text wx:if="{{item.courseOwnerText}}">{{bizRole === 'org_admin' ? '执行人' : '归属'}}：{{item.courseOwnerText}}</text>
      <text wx:if="{{item.courseTagText}}">课程码：{{item.courseTagText}}</text>
    </view>

    <!-- Desc -->
    <view class="desc">{{item.description}}</view>

    <!-- Action -->
    <!-- 新增：按权限隔离按钮显示
         - canManageClass=true（只有「待编辑」Tab + 课程创建者本人） → 显示“查看详情 + 进入管理”双按钮
         - 其他所有阶段/身份（待接取、进行中、已完成、非本人）→ 只能查看，隐藏进入管理按钮；查看按钮文案也改为“查看详情”，明确这是只读浏览。
    -->
    <view class="action-row">
      <button
        class="{{item.canManageClass ? 'secondary' : 'primary'}}"
        bindtap="onViewDetail"
        data-id="{{item.id}}"
      >
              {{item.canManageClass ? viewActionText : '查看详情'}}
      </button>
      <button
        wx:if="{{item.canManageClass}}"
        class="primary"
        bindtap="onManageClass"
        data-id="{{item.id}}"
      >
              {{manageActionText}}
      </button>
    </view>

  </view>

  <!-- Empty -->
  <view wx:if="{{tasks.length === 0}}" class="empty">
    <text class="icon">📋</text>
    <text>暂无{{tabs[currentTab].label}}的任务</text>
  </view>

</view>

</view>
