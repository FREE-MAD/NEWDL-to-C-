<view class="container">
  <view style="height: {{statusBarHeight}}px; width: 100%;"> <!-- 顶部安全区 --> </view>

  <!-- 新增分享态提示：分享进入优先走只读展示模式 -->
  <view class="share-entry-banner" wx:if="{{isShareEntry}}">
    当前为分享查看模式，可继续查看课节详情，不提供教练操作入口。
  </view>

  <view class="course-card">
    <view class="card-header">
      <text class="course-title">任务进度</text>
    </view>

    <!-- 旧“发布-上课-完成”步骤条保留注释，不删除；当前页面不再按课程状态推进展示 -->
    <!--
    <view class="progress-steps">
      <view class="step-item {{currentStep >= 0 ? 'active' : ''}}">
        <view class="step-circle">1</view>
        <text class="step-text">发布</text>
      </view>
      <view class="step-line {{currentStep >= 1 ? 'active' : ''}}"></view>

      <view class="step-item {{currentStep >= 1 ? 'active' : ''}}">
        <view class="step-circle">2</view>
        <text class="step-text">上课</text>
      </view>
      <view class="step-line {{currentStep >= 2 ? 'active' : ''}}"></view>

      <view class="step-item {{currentStep >= 2 ? 'active' : ''}}">
        <view class="step-circle">3</view>
        <text class="step-text">完成</text>
      </view>
    </view>
    -->

    <view class="progress-comment">
      <text class="comment-text">
        {{statusText || '当前页面只展示课程与课节信息。'}}
      </text>
    </view>
  </view>

  <view class="course-card">
    <view class="card-header">
      <view class="header-row">
        <text class="tag-intention">课程信息</text>
        <!-- 旧 fulfill_state 状态角标保留注释，不删除；当前只保留关闭态提示 -->
        <!-- <text class="tag-status">{{order.fulfill_state === 'completed' ? '已完成' : (order.fulfill_state === 'in_progress' ? '进行中' : '待开始')}}</text> -->
        <text class="tag-status">{{order.fulfill_state === 'cancelled' || order.fulfill_state === 'closed' ? '已关闭' : '可查看'}}</text>
      </view>
      <view class="course-title">{{order.title || '任务详情'}}</view>
    </view>

    <view class="card-body">
      <view class="info-row" wx:if="{{order.category}}">
        <text class="label">分类：</text>
        <text class="value">{{order.category}}</text>
      </view>
      <view class="info-row" wx:if="{{order.course_size_mode}}">
        <text class="label">课程人数：</text>
        <text class="value">{{order.course_size_mode}}</text>
      </view>
      <view class="info-row">
        <text class="label">地点：</text>
        <text class="value">{{order.location || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="label">创建：</text>
        <text class="value">{{createdTimeDisplay || '未记录'}}</text>
      </view>
      <view class="info-row" wx:if="{{pageMode !== 'share_viewer' && (order.child_age || order.child_gender || order.child_height || order.child_weight)}}">
        <text class="label">孩子信息：</text>
        <text class="value">{{order.child_age || '-'}}岁 / {{order.child_gender || '未填'}} / {{order.child_height || '-'}}cm / {{order.child_weight || '-'}}kg</text>
      </view>
      <view class="info-row" wx:if="{{order.description}}">
        <text class="label">说明：</text>
        <text class="value">{{order.description}}</text>
      </view>
    </view>
    <!-- 旧当前流程状态展示保留注释，不删除；当前不再用它表达课程是否上课/下课 -->
    <!--
    <view class="status-text">
          当前: {{statusText}}
    </view>
    -->
    <view class="status-text">
          当前: 课节详情可直接查看
    </view>
    <view class="action-bar-wrapper" wx:if="{{pageMode === 'normal' && isCoach}}">
      <view class="action-bar">
        <!-- <view class="action-right">
          新增展示页职责说明：课程操作统一迁移到 publish 教练操作台
          <button class="btn-main edit-op" bindtap="handleGoCoachConsole">进入教练操作台</button>
        </view> -->
      </view>
    </view>
  </view>

  <view class="course-card" wx:if="{{displaySchedule && displaySchedule.length > 0}}">
    <view class="card-header">
      <text class="course-title">课程进度表 ({{order.progress_done}}/{{order.progress_total}})</text>
      <!-- 新增半途接入说明：展示页和教练操作台保持一致，先显示历史汇总框 -->
      <view class="sync-hint" wx:if="{{order.progress_done > 0}}">已完成前 {{order.progress_done}} 节历史课，下面会先显示历史汇总框，再显示剩余课节。</view>
    </view>
    <view class="schedule-list">
      <block wx:for="{{displaySchedule}}" wx:key="index">
        <view
          class="single-schedule-item {{item.status === 'DONE' ? 'done' : ''}} {{item.isHistorySummary ? 'history-summary-item' : ''}}"
          bindtap="handleToClassDetail"
          data-index="{{item.actualIndex}}"
          data-history="{{item.isHistorySummary ? 1 : 0}}"
        >
          <view class="schedule-left">
            <text class="lesson-index">{{item.isHistorySummary ? ('第 ' + item.title + ' 课') : ('第 ' + (item.lesson || (index + 1)) + ' 课')}}</text>
            <!-- 旧课节状态标签类保留注释，不删除；当前统一展示为课节记录 -->
            <!-- <view class="lesson-status-tag {{item.isHistorySummary ? 'DONE' : item.status}}">{{item.statusText}}</view> -->
            <view class="lesson-status-tag">{{item.isHistorySummary ? '历史汇总' : '课节记录'}}</view>
          </view>

          <view class="schedule-action">
            <text class="action-text">{{item.isHistorySummary ? '历史汇总' : '查看详情'}}</text>
            <text class="iconfont icon-right" wx:if="{{!item.isHistorySummary}}"></text>
          </view>
        </view>
      </block>

    </view>
  </view>
</view>
