page {
  background: #f6f7fb;
}

.page {
  padding-bottom: 60rpx;
}

/* 顶部渐变背景 */
/* 初始展开状态 header */
.header {
  background: linear-gradient(135deg, #635bff, #7644ff);
  padding: 180rpx 40rpx 300rpx; /* 初始展开高度，可以自己调 */
  border-bottom-left-radius: 70rpx;
  border-bottom-right-radius: 70rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: all 0.5s ease;
}


/* 展开状态时自动显示（header 没有 collapsed） */
.header:not(.collapsed) .select-identity {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
/* 展开top=====s */
/* ===== 顶部身份选择卡片 id_select ===== */
.id_select {
  margin: 40rpx auto;
  width: 80%;
  background: #ffffff;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  font-size: 32rpx;
  color: #333;
}

/* 标题 */
.id_select > view:first-child {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

/* 身份项 */
.id_select > view:not(:first-child) {
  padding: 24rpx 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.2s;
}
/* 默认身份项样式 */
.id_select > view:not(:first-child) {
  padding: 24rpx 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.25s;
  color: #333;
}

/* 选中后的高亮态 */
.id_select .active {
  background: #4a90e2 !important;
  color: #fff !important;
  transform: scale(1.02);
  box-shadow: 0 6rpx 18rpx rgba(74,144,226,0.4);
}


/* ========================================================= */
/* 统一 getxx（完善信息部分） 与 id_select 样式一致 */
/* ========================================================= */

.getxx {
  margin: 40rpx auto;
  width: 80%;
  background: #ffffff;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.getxx_head {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 头像选择区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.avatar-wrapper {
  padding: 0;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50%;
  margin: 0;
  background-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-tip {
  font-size: 24rpx;
  color: #888;
  margin-top: 14rpx;
}

/* 微信登录按钮样式 */
.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  border: none;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 自动采集区域 */
.Automatic {
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 手动输入框区域 */
.Artificial {
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.Artificial .manual-label {
  font-size: 28rpx;
  color: #333;
  text-align: left;
  width: 100%;
}

/* 输入框统一样式 */
.Artificial input {
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1px solid #ddd;
  background: #fff;
  font-size: 28rpx;
}


/* 协议区域 */
.Agreement {
  margin: 20rpx auto 0;
  width: 80%;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  font-size: 28rpx;
}

/* 提交 / 取消 */
.addorout {
  margin: 20rpx auto 40rpx;
  width: 80%;
  display: flex;
  justify-content: space-between;
  gap: 30rpx;
}

.addorout view {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #4a90e2;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  transition: all 0.2s;
}

.addorout view:last-child {
  background: #ccc;
  color: #333;
}

.addorout view:active {
  transform: scale(0.97);
}

/* 展开top=====e */
/* s表单input 手动与自动=========================================== */

/* 新增：完善信息按钮===================== */
.complete-btn {
  margin-top: 30rpx;
}
.select-identity {
  margin-top: 40rpx;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.45s ease;
  pointer-events: none;

  padding: 40rpx 30rpx;
  background: #f5f6fa;
  border-radius: 28rpx;
}
.Artificial view:first-child {
  font-size: 25rpx;
  font-weight: 60;
  color: #333;
  margin-bottom: 20rpx;
}

.complete-btn button {
  background: #ffffff33;
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: 2rpx solid #ffffff55;
}
/* 新增：Select Identity 动画（初始隐藏）============================= */

/* 四大模块统一卡片样式 */
.select-identity .Automatic,
.select-identity .Artificial,
.select-identity .Agreement,
.select-identity .addorout {
  background: #ffffff;
  padding: 36rpx 42rpx;
  margin-bottom: 34rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  transition: 0.3s;
}

/* 鼠标/手指触摸微动效 */
.addorout view:active {
  transform: scale(0.98);
}
/* ---------------------------------- */
/* 1 自动采集 */
/* ---------------------------------- */
.select-identity .Automatic {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* 勾选框缩放 */
.select-identity .Automatic checkbox {
  transform: scale(0.85);
}

/* ---------------------------------- */
/* 2 手动输入区域 */
/* ---------------------------------- */
.select-identity .Artificial input {
  width: 90%;
  background: #f7f8fc;
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: 0.2s;
}

/* 聚焦时 — 更高级 */
.select-identity .Artificial input:focus {
  background: #fff;
  border-color: #635bff;
  box-shadow: 0 0 0 4rpx rgba(99, 91, 255, 0.2);
}

/* ---------------------------------- */
/* 3 协议勾选 */
/* ---------------------------------- */
.select-identity .Agreement {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

/*———————————————*/
/* 勾选框统一更美观 */
/*———————————————*/
.select-identity checkbox {
  transform: scale(0.85);
  margin-right: 14rpx;
  border-radius: 18rpx;
}

/* ---------------------------------- */
/* 4 底部按钮区 */
/* ---------------------------------- */
.select-identity .addorout {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 10rpx;
}

/* 提交按钮 */
.select-identity .addorout view:nth-child(1) {
  flex: 1;
  background: linear-gradient(135deg, #7c73ff, #5a52ff);
  color: #fff;
  padding: 28rpx 0;
  border-radius: 18rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(99, 91, 255, 0.3);
  transition: 0.15s;
}

/* 点击时轻微缩放 */
.select-identity .addorout view:nth-child(1):active {
  transform: scale(0.96);
}

/* 取消按钮 */
.select-identity .addorout view:nth-child(2) {
  width: 180rpx;
  background: #f1f2f6;
  color: #999;
  padding: 28rpx 0;
  border-radius: 18rpx;
  text-align: center;
  font-size: 30rpx;
  transition: 0.15s;
}

/* 点击缩放 */
.select-identity .addorout view:nth-child(2):active {
  transform: scale(0.96);
}
.form-tip {
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
  background-color: #e8f9e8;
  border-left: 8rpx solid #07c160;
  border-radius: 16rpx;

  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;

  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { 
    opacity: 0; 
    transform: translateY(-10rpx); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0); 
  }
}

/* e===================================== */
/* 缩小后的 header（即你提供的尺寸） */
.header.collapsed {
  padding: 80rpx 40rpx 180rpx; 
  border-bottom-left-radius: 70rpx;
  border-bottom-right-radius: 70rpx;
  justify-content: flex-end;
}

.hello {
  font-size: 42rpx;
  font-weight: 700;
  transition: font-size 0.5s ease;
}

.header.collapsed .hello {
  font-size: 32rpx;
}

.location {
  margin-top: 10rpx;
  opacity: 0.9;
  font-size: 26rpx;
  transition: opacity 0.5s ease;
}

.header.collapsed .location {
  opacity: 1;
}

/* 身份选择区 */
.role-selection {
  margin-top: 40rpx;
  display: flex;
  gap: 40rpx;
  transition: opacity 0.5s ease;
}

.role-selection.hidden {
  opacity: 0;
  pointer-events: none;
}

.role-selection button {
  background: #fff;
  color: #635bff;
  font-weight: bold;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 通知铃铛 */
.bell {
  width: 60rpx;
  height: 60rpx;
  background: #ffffff33;
  border-radius: 20rpx;
  position: relative;
}

.red-dot {
  background: #ff3b30;
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}

/* 四宫格卡片 */
.grid-box {
  margin-top: -120rpx;
  padding: 0 40rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.grid-item {
  background: #fff;
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.06);
  opacity: 0;
  transform: translateY(-50rpx);
  transition: all 0.5s ease;
}

.grid-item.visible {
  opacity: 1;
  transform: translateY(0);
}

.icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.purple { background: #655cff; }
.green { background: #0bbf80; }
.orange { background: #f59e0b; }
.red { background: #ef4444; }

.grid-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.grid-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #777;
}

.big_view {
  margin-top: 24rpx;
}

.section-title {
  margin: 50rpx 40rpx 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 700;
}

.view-all {
  font-size: 26rpx;
  color: #4b6bff;
}

.post-card {
  margin: 12rpx 40rpx;
  background: #fff;
  padding: 26rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.06);
}

.post-header {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}

.post-time {
  color: #888;
}

.post-tag {
  margin-top: 18rpx;
  background: #fff6c2;
  color: #a67c00;
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.post-text {
  margin-top: 20rpx;
  color: #555;
  font-size: 28rpx;
  line-height: 1.4;
}

.post-img {
  width: 100%;
  height: 300rpx;
  border-radius: 26rpx;
  margin-top: 25rpx;
  object-fit: cover;
}

.post-footer {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
}

.details {
  margin-left: auto;
  color: #4b6bff;
  font-size: 28rpx;
}
