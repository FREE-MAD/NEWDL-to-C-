  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 4rpx;
}

.primary-manage-shortcut-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.92);
}

.primary-manage-shortcut-arrow {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.primary-panel:active {
