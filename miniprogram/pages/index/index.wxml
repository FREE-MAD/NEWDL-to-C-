<view class="page">
<!-- 常驻状态====== -->
  <!-- 提示信息 -->
  <view wx:if="{{formSuccess}}" class="form-tip"> {{formSuccess}}</view>

  <!-- 常驻状态（仅在登录后显示） -->
  <view class="header {{headerState}}">
    <!-- 首页欢迎区新样式：补充顶部胶囊按钮和右侧装饰，让首页第一屏更有引导感 -->
    <view class="header-topbar">
      <view class="header-left">
        <view class="hello"> {{welcome}} 👋</view>
        <view class="header-desc">{{headerDesc}}</view>
        <view class="location">
          <!-- 📍 北京市朝阳区 -->
        </view>
      </view>
    </view>

    <!-- 首页欢迎区右侧装饰：用简单图形模拟插画感，不影响任何业务逻辑 -->
    <view class="header-illustration">
      <text class="header-spark header-spark-left">✦</text>
      <text class="header-spark header-spark-right">+</text>
      <view class="header-note-card">
        <view class="header-note-rings">
          <view class="header-note-ring"></view>
          <view class="header-note-ring"></view>
          <view class="header-note-ring"></view>
        </view>
        <view class="header-note-page">
          <view class="header-note-line"></view>
          <view class="header-note-line short"></view>
          <view class="header-note-line"></view>
        </view>
        <view class="header-note-pencil"></view>
      </view>
    </view>
  </view>

