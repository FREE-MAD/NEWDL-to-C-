/* pages/index/events/list/list.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.filter-section {
  background: white;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.category-scroll {
  margin-bottom: 16rpx;
}

category-scroll scroll-view {
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 20rpx;
  background: #f0f0f0;
}

.category-item.active {
  background: #007AFF;
  color: white;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
}

.sort-btn, .filter-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  background: #f8f9fa;
  font-size: 26rpx;
  color: #666;
}

.sort-text, .filter-text {
  margin-right: 8rpx;
}

.sort-arrow, .filter-icon {
  font-size: 20rpx;
}

.event-list {
  padding: 0 20rpx;
}

.event-item {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.event-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.event-content {
  padding: 24rpx;
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.event-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.event-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1px solid;
  white-space: nowrap;
}

.event-info {
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  width: 24rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

.event-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #007AFF;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
}

.event-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tag-item {
  font-size: 24rpx;
  color: #007AFF;
  background: #e3f2fd;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.event-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.detail-btn {
  background: #007AFF;
  color: white;
}

.register-btn {
  background: #4CAF50;
  color: white;
}

.cancel-btn {
  background: #ff9800;
  color: white;
}

.live-btn {
  background: #f44336;
  color: white;
}

.share-btn {
  background: #9C27B0;
  color: white;
}

.loading-more, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  display: block;
}