<view class="page">
<!-- 常驻状态====== -->
  <!-- 提示信息 -->
  <view wx:if="{{formSuccess}}" class="form-tip"> {{formSuccess}}</view>

  <!-- 常驻状态（仅在登录后显示） -->
  <view class="header {{headerState}}">
    <!-- 首页欢迎区新样式：补充顶部胶囊按钮和右侧装饰，让首页第一屏更有引导感 -->
    <view class="header-topbar">
      <view class="header-left">
        <!-- 首页新增业务模式标签：让用户一眼知道自己当前走的是哪条工作流 -->
        <view class="mode-badges">
          <view class="mode-badge">{{bizRoleLabel}}</view>
          <view wx:if="{{orgName}}" class="mode-badge org-name-badge">{{orgName}}</view>
        </view>
        <view class="hello"> {{welcome}} 👋</view>
        <view class="header-desc">{{headerDesc}}</view>
        <view class="location">
          <!-- 📍 北京市朝阳区 -->
        </view>
      </view>
    </view>

  </view>

