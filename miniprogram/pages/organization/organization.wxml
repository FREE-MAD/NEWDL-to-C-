<!--pages/organization/organization.wxml-->
<view class="organization-page">
  <!-- 新增机构入口模块：把这个 tab 正式变成机构管理层 / 执行教练的进入入口 -->
  <view class="entry-section">
    <view class="entry-hero">
      <view class="entry-badges">
        <view class="entry-badge">团队入口</view>
        <view class="entry-badge entry-badge-soft">{{currentBizRoleLabel}}</view>
        <view wx:if="{{currentOrgName}}" class="entry-badge entry-badge-soft">{{currentOrgName}}</view>
      </view>
      <view class="entry-title">{{entryTitle}}</view>
      <view class="entry-desc">{{entryDesc}}</view>
      <view class="entry-hint">{{entryHint}}</view>
    </view>

    <view class="entry-action-list">
      <view
        wx:for="{{entryActionList}}"
        wx:key="title"
        class="entry-action-card"
        data-action="{{item.action}}"
        bindtap="onEntryActionTap"
        hover-class="entry-action-card-active"
        hover-stay-time="80"
      >
        <!-- 新增整卡可点击：用户点“创建机构/加入机构”整块区域都触发同一动作，不再只能点底部小按钮 -->
        <!-- 新增（2026-09-21）：团队管理卡的待确认申请徽标，有数量时才出现 -->
        <view class="entry-action-title-row">
          <view class="entry-action-title">{{item.title}}</view>
          <view wx:if="{{item.badge}}" class="entry-action-badge">{{item.badge}}</view>
        </view>
        <view class="entry-action-desc">{{item.desc}}</view>
        <view class="entry-action-button">
          {{item.buttonText}}
        </view>
      </view>
    </view>
  </view>

  <!-- 新增机构结果卡片承接：创建机构/加入机构成功后的结果卡片从 organization_show 内移到外面，紧跟机构入口区展示 -->
  <view wx:if="{{submitResultCard}}" class="result-card">
    <view class="result-title">{{submitResultCard.title}}</view>
    <view class="result-row">团队名称：{{submitResultCard.organizationName}}</view>
    <!-- 新增：机构邀请码支持点击复制到剪贴板，方便教练/管理员分享给其他成员 -->
    <view wx:if="{{submitResultCard.invitationCode}}" class="result-row result-row-copyable" bindtap="onCopyInvitationCode" data-code="{{submitResultCard.invitationCode}}">
      <text>团队邀请码：</text>
      <text class="invitation-code-text">{{submitResultCard.invitationCode}}</text>
      <text class="copy-btn">复制</text>
    </view>
    <view class="result-row">当前身份：{{submitResultCard.memberRoleLabel}}</view>
    <view class="result-desc">{{submitResultCard.message}}</view>
  </view>

  <!-- 新增（2026-09-06）：家长端展示预览语义提示条 —— 按「默认 / 修改 / 同步」三段讲清下方 organization_show 长图的语义：
       ① 默认：长图即家长扫码进入家长端看到的团队展示，未填写资料以默认示例兜底；
       ② 修改：团队管理层从上方「修改信息」入口进编辑页改资料（仅管理层展示该行）；
       ③ 同步：保存后点本条下方通栏「同步展示信息」按钮一键补推 A→B dev_forPshowC（仅管理层展示该行与按钮）。
       原入口区「同步展示信息」按钮一并移入本条内（文案下方通栏展示），复用 SYNC_ORG_SHOW 动作分发，交互逻辑不变 -->
  <view class="os-preview-hint">
    <view class="os-preview-hint-body">
      <view class="os-preview-hint-title">家长端展示预览</view>
      <!-- 默认：所有身份都可见，说明下方长图的预览语义与默认兜底规则 -->
      <view class="os-preview-hint-row">
        <text class="os-preview-hint-tag">默认</text>
        <text class="os-preview-hint-text">下方长图就是家长扫码进入家长端后看到的团队展示效果；团队资料未填写的部分，以默认示例内容兜底展示。</text>
      </view>
      <!-- 修改 / 同步：仅团队管理层可见，对应「去修改 → 保存 → 点同步」的操作闭环 -->
      <block wx:if="{{currentBizRole === 'org_admin'}}">
        <view class="os-preview-hint-row">
          <text class="os-preview-hint-tag">修改</text>
          <text class="os-preview-hint-text">点上方「修改信息」进入编辑页修改团队资料，保存后团队邀请码保持不变。</text>
        </view>
        <view class="os-preview-hint-row">
          <text class="os-preview-hint-tag">同步</text>
          <text class="os-preview-hint-text">保存后点下方「同步展示信息」按钮，最新资料立即推送到家长端展示（幂等覆盖，随时可点）。</text>
        </view>
      </block>
    </view>
    <!-- 同步按钮：复用入口动作分发，data-action 仍为 SYNC_ORG_SHOW，交互逻辑与原入口卡片完全一致 -->
    <view
      wx:if="{{currentBizRole === 'org_admin'}}"
      class="os-preview-hint-btn"
      data-action="SYNC_ORG_SHOW"
      bindtap="onEntryActionTap"
      hover-class="os-preview-hint-btn-active"
      hover-stay-time="80"
    >同步展示信息</view>
  </view>

  <!-- 新增机构展示总容器：深色海军蓝斜切背景 + 红色斜切块 + 白色卡片堆叠，对应"星耀体育训练中心"长图设计 -->
  <view class="organization_show">
    <!-- 装饰斜线 / 红色斜切块：模拟设计稿里的动效线与右上、左下红色色块（原 os-deco-line-1~6 与 os-deco-red-right/os-deco-red-bottom 共 8 个装饰 view 已按要求删除，仅保留本注释） -->

    <!-- 1. 顶部品牌 Hero：训练图片轮播 + 文字遮罩 + 轮播指示器 -->
    <view class="os-hero">
      <swiper
        class="os-hero-swiper"
        circular="{{brandHeroSlides.length > 1}}"
        autoplay="{{brandHeroSlides.length > 1}}"
        interval="4000"
        duration="500"
        indicator-dots="{{false}}"
        bindchange="onBrandHeroChange"
      >
        <swiper-item wx:for="{{brandHeroSlides}}" wx:key="index">
          <image
            wx:if="{{item.imageUrl}}"
            class="os-hero-image"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onBrandHeroImageError"
          />
          <view wx:else class="os-hero-image os-hero-placeholder">
            <view class="os-hero-placeholder-text">训练现场图片</view>
          </view>
        </swiper-item>
      </swiper>

      <view class="os-hero-mask"></view>

      <!-- 轮播指示器：只有多张图时才展示，指示点随当前页切换 -->
      <view wx:if="{{brandHeroSlides.length > 1}}" class="os-hero-dots">
        <block wx:for="{{brandHeroSlides}}" wx:key="index">
          <view class="os-hero-dot {{brandHeroCurrent === index ? 'os-hero-dot-active' : ''}}"></view>
        </block>
      </view>

      <view class="os-hero-text">
        <view class="os-hero-title">{{organizationProfile.organizationName}}</view>
        <view class="os-hero-subtitle">{{organizationProfile.slogan}}</view>
      </view>
    </view>

    <!-- 2. 机构简介卡：4 行字段（成立时间 / 课程项目 / 招生对象 / 训练理念） -->
    <!-- 调整（2026-09-05）：改为 4 行字段（核心服务 / 服务区域 / 适合谁 / 教练理念），渲染 introInfoList；字段缺省时 JS 层已退回默认（完整）值，展示永远完整不空；「成立时间」行非必要已移除 -->
    <view class="os-card os-intro-card">
      <view class="os-card-head">
        <view class="os-card-dot"></view>
        <view class="os-card-title">机构简介</view>
        <view class="os-card-dot"></view>
      </view>

      <block wx:for="{{introInfoList}}" wx:key="label">
        <view class="os-intro-row">
          <view class="os-intro-bullet"></view>
          <view class="os-intro-label">{{item.label}}</view>
          <view class="os-intro-value">{{item.value}}</view>
        </view>
      </block>
    </view>

    <!-- 3. 团队成员：一人一行一个块；真实成员按加入顺序向下追加（默认兜底 1 人），
         列表最多同时展示 5 人，超过 5 人时末尾出现「展开全部 / 收起」 -->
    <view class="os-card os-team-card">
      <view class="os-card-head">
        <view class="os-card-dot"></view>
        <view class="os-card-title">团队成员</view>
        <view class="os-card-dot"></view>
      </view>

      <view class="os-team-grid">
        <block wx:for="{{teamMembers}}" wx:key="name" wx:for-index="teamIndex">
          <view wx:if="{{teamShowAll || teamIndex < 5}}" class="os-team-item">
            <view class="os-team-avatar">
              <image
                wx:if="{{item.avatarUrl}}"
                class="os-team-avatar-image"
                src="{{item.avatarUrl}}"
                mode="aspectFill"
              />
              <text wx:else class="os-team-avatar-text">{{item.avatar || item.name}}</text>
            </view>
            <view class="os-team-info">
              <view class="os-team-name">{{item.name}}</view>
              <view class="os-team-role">{{item.role}}</view>
            </view>
          </view>
        </block>

        <!-- 成员超过 5 人时才出现折叠入口，点击切换全部展开 / 收起 -->
        <view wx:if="{{teamMembers.length > 5}}" class="os-team-toggle" bindtap="onToggleTeamMembers">
          <text class="os-team-toggle-text">{{teamShowAll ? '收起' : '展开全部'}}</text>
          <text class="os-team-toggle-arrow {{teamShowAll ? 'os-team-toggle-arrow-up' : ''}}">▾</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showLegacySection}}">
  <!-- 新增机构头部展示：先让用户一进来就知道这是做什么的 -->
  <view class="hero-section">
    <view class="hero-badge">{{orgInfo.badge}}</view>
    <view class="hero-title">{{orgInfo.name}}</view>
    <view class="hero-slogan">{{orgInfo.slogan}}</view>
    <view class="hero-intro">{{orgInfo.intro}}</view>
    <view class="hero-sub-intro">{{orgInfo.subIntro}}</view>

    <view class="hero-stats">
      <block wx:for="{{quickStats}}" wx:key="label">
        <view class="stat-card">
          <view class="stat-value">{{item.value}}</view>
          <view class="stat-label">{{item.label}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 新增服务内容模块：把机构主要做什么直接展开给用户看 -->
  <view class="section-card">
    <view class="section-head">
      <view class="section-title">我们主要做什么</view>
      <view class="section-subtitle">先看服务方向，再决定适不适合你</view>
    </view>

    <view class="service-grid">
      <block wx:for="{{serviceList}}" wx:key="title">
        <view class="service-card">
          <view class="service-title">{{item.title}}</view>
          <view class="service-desc">{{item.desc}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 新增适合人群模块：帮助家长快速判断自己是不是目标用户 -->
  <view class="section-card">
    <view class="section-head">
      <view class="section-title">适合哪些人</view>
      <view class="section-subtitle">如果你正处于这些情况，这个页面就和你有关</view>
    </view>

    <block wx:for="{{fitCrowdList}}" wx:key="*this">
      <view class="list-row">
        <view class="list-dot"></view>
        <view class="list-text">{{item}}</view>
      </view>
    </block>
  </view>

  <!-- 新增服务流程模块：让用户知道进来后第一步做什么、后面怎么走 -->
  <view class="section-card">
    <view class="section-head">
      <view class="section-title">合作流程</view>
      <view class="section-subtitle">从了解需求到开始训练，路径尽量讲清楚</view>
    </view>

    <block wx:for="{{processList}}" wx:key="step">
      <view class="process-row">
        <view class="process-step">{{item.step}}</view>
        <view class="process-content">
          <view class="process-title">{{item.title}}</view>
          <view class="process-desc">{{item.desc}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 新增机构优势模块：强调这个页面适合承担宣传和转化入口 -->
  <view class="section-card highlight-card">
    <view class="section-head">
      <view class="section-title">为什么先做这个页面</view>
      <view class="section-subtitle">它更像一个团队门面，负责先把信任建立起来</view>
    </view>

    <view class="advantage-grid">
      <block wx:for="{{advantageList}}" wx:key="*this">
        <view class="advantage-item">{{item}}</view>
      </block>
    </view>
  </view>

  <!-- 新增底部联系模块：先把下一步动作讲清楚，后续再接真实按钮 -->
  <view class="contact-card">
    <view class="contact-title">下一步可以放什么</view>
    <view class="contact-desc">当前先完成团队展示页面，后面可以继续往下接课程入口、咨询入口、真实案例和教练团队。</view>

    <block wx:for="{{bottomActionList}}" wx:key="*this">
      <view class="contact-tag">{{item}}</view>
    </block>
  </view>
  </view>
</view>
