/* pages/profile/edit/edit.wxss */
.page {
  min-height: 100vh;
  background: #f4f5f9;
  padding-bottom: 180rpx;
}

.header {
  padding: 108rpx 32rpx 32rpx;
  background: linear-gradient(150deg, #6f4aff, #140043);
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  color: #fff;
}

.header-main {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.header-avatar-wrap {
  flex-shrink: 0;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.header-name {
  font-size: 46rpx;
  font-weight: 600;
  word-break: break-all;
}

.header-id {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.header-tagline {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.header-avatar {
  width: 146rpx;
  height: 146rpx;
  border-radius: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.18);
}

.header-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.header-stats {
  margin-top: 14rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
}

.header-stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.header-stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: -8rpx;
  top: 18rpx;
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header-stat-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.header-stat-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.header-stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.content {
  padding: 24rpx 24rpx 0;
}

.loading-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.05);
}

.profile-card,
.intro-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(30, 24, 70, 0.06);
}

.profile-card {
  margin-top: -18rpx;
}

.intro-card {
  margin-top: 0;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f6;
}

.card-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-title-icon {
  font-size: 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1446;
}

.card-edit {
  font-size: 28rpx;
  color: #6f4aff;
}

.profile-row {
  height: 102rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #eef0f6;
}

.profile-row-multiline {
  height: auto;
  min-height: 102rpx;
  align-items: flex-start;
  padding: 24rpx 0;
}

.profile-row:last-child {
  border-bottom: none;
}

.row-icon {
  width: 52rpx;
  font-size: 28rpx;
  text-align: center;
}

.row-label {
  width: 124rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4a4f66;
}

.row-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2f3142;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-value-multiline {
  white-space: normal;
  overflow: visible;
  text-overflow: unset;
  line-height: 1.6;
}

.row-value-line {
  line-height: 1.6;
}

.row-value-line + .row-value-line {
  margin-top: 6rpx;
}

/* 保留说明：用户要求把行尾箭头统一移到底部操作区，相关样式先保留注释位置 */

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5e46ff;
}

.intro-text {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #4a4f66;
  line-height: 1.8;
  word-break: break-all;
}

.loading-box {
  text-align: center;
  color: #8b90a7;
  font-size: 28rpx;
}

.bottom-bar {
  margin: 0 24rpx 36rpx;
  padding: 24rpx 24rpx 36rpx;
  background: transparent;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.edit-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(150deg, #6f4aff, #140043);
  color: #fff;
  font-size: 30rpx;
  border: none;
}

.edit-btn::after {
  border: none;
}

.secondary-btn {
  background: #ffffff;
  color: #6f4aff;
  border: 2rpx solid #d9d3ff;
}
