page {
  background: #f5f4fb;
}

.page {
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* 顶部渐变背景 */
/* 初始展开状态 header */
.header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #ece6ff 0%, #e8e3fb 58%, #f5f4fb 100%);
  padding: 86rpx 34rpx 168rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  color: #2e246d;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  transition: all 0.5s ease;
}

.header::before {
  content: '';
  position: absolute;
  top: 40rpx;
  right: -40rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(140, 112, 255, 0.18) 0%, rgba(140, 112, 255, 0) 72%);
}

.header::after {
  content: '';
  position: absolute;
  right: 80rpx;
  bottom: 46rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 72%);
}

.header-topbar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.header-tools {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 60rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 24rpx rgba(123, 103, 212, 0.08);
}

.header-tools-dots {
  font-size: 26rpx;
  line-height: 1;
  color: #1f1f1f;
  letter-spacing: 2rpx;
}

.header-tools-divider {
  width: 2rpx;
  height: 24rpx;
  margin: 0 14rpx;
  background: rgba(31, 31, 31, 0.12);
}

.header-tools-circle {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #1f1f1f;
  border-radius: 50%;
  box-sizing: border-box;
}

.header-desc {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #706b8f;
  line-height: 1.4;
}

.header-illustration {
  position: absolute;
  right: 24rpx;
  bottom: 66rpx;
  width: 240rpx;
  height: 180rpx;
  z-index: 1;
}

.header-spark {
  position: absolute;
  color: #f9c73f;
  text-shadow: 0 8rpx 18rpx rgba(249, 199, 63, 0.28);
}

.header-spark-left {
  top: 18rpx;
  left: 0;
  font-size: 44rpx;
}

.header-spark-right {
  top: 22rpx;
  right: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.header-note-card {
  position: absolute;
  right: 14rpx;
  bottom: 0;
  width: 144rpx;
  height: 160rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(132, 103, 255, 0.96) 0%, rgba(94, 70, 242, 0.94) 100%);
  box-shadow: 0 18rpx 30rpx rgba(109, 90, 228, 0.22);
  transform: rotate(10deg);
}

.header-note-page {
  position: absolute;
  left: 24rpx;
  top: 34rpx;
  width: 96rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
}

.header-note-line {
  width: 54rpx;
  height: 8rpx;
  margin: 18rpx auto 0;
  border-radius: 999rpx;
  background: rgba(104, 88, 214, 0.22);
}

.header-note-line.short {
  width: 40rpx;
}

.header-note-rings {
  position: absolute;
  top: 8rpx;
  left: 28rpx;
  display: flex;
  gap: 10rpx;
}

.header-note-ring {
  width: 12rpx;
  height: 18rpx;
  border: 4rpx solid #8f71ff;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
  background: #d7ccff;
}

.header-note-pencil {
  position: absolute;
  right: -10rpx;
  bottom: 18rpx;
  width: 18rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffd24b 0%, #f8b61e 100%);
  box-shadow: 0 4rpx 10rpx rgba(248, 182, 30, 0.2);
}


/* 展开状态时自动显示（header 没有 collapsed） */
.header:not(.collapsed) .select-identity {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
/* 展开top=====s */
/* ===== 顶部身份选择卡片 id_select ===== */
.id_select {
  margin: 40rpx auto;
  width: 80%;
  background: #ffffff;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  font-size: 32rpx;
  color: #333;
}

/* 标题 */
.id_select > view:first-child {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

/* 身份项 */
.id_select > view:not(:first-child) {
  padding: 24rpx 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.2s;
}
/* 默认身份项样式 */
.id_select > view:not(:first-child) {
  padding: 24rpx 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.25s;
  color: #333;
}

/* 选中后的高亮态 */
.id_select .active {
  background: #4a90e2 !important;
  color: #fff !important;
  transform: scale(1.02);
  box-shadow: 0 6rpx 18rpx rgba(74,144,226,0.4);
}


/* ========================================================= */
/* 统一 getxx（完善信息部分） 与 id_select 样式一致 */
/* ========================================================= */

.getxx {
  margin: 40rpx auto;
  width: 80%;
  background: #ffffff;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.getxx_head {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 头像选择区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.avatar-wrapper {
  padding: 0;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50%;
  margin: 0;
  background-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-tip {
  font-size: 24rpx;
  color: #888;
  margin-top: 14rpx;
}

/* 微信登录按钮样式 */
.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  border: none;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 自动采集区域 */
.Automatic {
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 手动输入框区域 */
.Artificial {
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.Artificial .manual-label {
  font-size: 28rpx;
  color: #333;
  text-align: left;
  width: 100%;
}

/* 输入框统一样式 */
.Artificial input {
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1px solid #ddd;
  background: #fff;
  font-size: 28rpx;
}


/* 协议区域 */
.Agreement {
  margin: 20rpx auto 0;
  width: 80%;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  font-size: 28rpx;
}

/* 提交 / 取消 */
.addorout {
  margin: 20rpx auto 40rpx;
  width: 80%;
  display: flex;
  justify-content: space-between;
  gap: 30rpx;
}

.addorout view {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #4a90e2;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  transition: all 0.2s;
}

.addorout view:last-child {
  background: #ccc;
  color: #333;
}

.addorout view:active {
  transform: scale(0.97);
}

/* 展开top=====e */
/* s表单input 手动与自动=========================================== */

/* 新增：完善信息按钮===================== */
.complete-btn {
  margin-top: 30rpx;
}
.select-identity {
  margin-top: 40rpx;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.45s ease;
  pointer-events: none;

  padding: 40rpx 30rpx;
  background: #f5f6fa;
  border-radius: 28rpx;
}
.Artificial view:first-child {
  font-size: 25rpx;
  font-weight: 60;
  color: #333;
  margin-bottom: 20rpx;
}

.complete-btn button {
  background: #ffffff33;
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: 2rpx solid #ffffff55;
}
/* 新增：Select Identity 动画（初始隐藏）============================= */

/* 四大模块统一卡片样式 */
.select-identity .Automatic,
.select-identity .Artificial,
.select-identity .Agreement,
.select-identity .addorout {
  background: #ffffff;
  padding: 36rpx 42rpx;
  margin-bottom: 34rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  transition: 0.3s;
}

/* 鼠标/手指触摸微动效 */
.addorout view:active {
  transform: scale(0.98);
}
/* ---------------------------------- */
/* 1 自动采集 */
/* ---------------------------------- */
.select-identity .Automatic {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* 勾选框缩放 */
.select-identity .Automatic checkbox {
  transform: scale(0.85);
}

/* ---------------------------------- */
/* 2 手动输入区域 */
/* ---------------------------------- */
.select-identity .Artificial input {
  width: 90%;
  background: #f7f8fc;
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: 0.2s;
}

/* 聚焦时 — 更高级 */
.select-identity .Artificial input:focus {
  background: #fff;
  border-color: #635bff;
  box-shadow: 0 0 0 4rpx rgba(99, 91, 255, 0.2);
}

/* ---------------------------------- */
/* 3 协议勾选 */
/* ---------------------------------- */
.select-identity .Agreement {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

/*———————————————*/
/* 勾选框统一更美观 */
/*———————————————*/
.select-identity checkbox {
  transform: scale(0.85);
  margin-right: 14rpx;
  border-radius: 18rpx;
}

/* ---------------------------------- */
/* 4 底部按钮区 */
/* ---------------------------------- */
.select-identity .addorout {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 10rpx;
}

/* 提交按钮 */
.select-identity .addorout view:nth-child(1) {
  flex: 1;
  background: linear-gradient(135deg, #7c73ff, #5a52ff);
  color: #fff;
  padding: 28rpx 0;
  border-radius: 18rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(99, 91, 255, 0.3);
  transition: 0.15s;
}

/* 点击时轻微缩放 */
.select-identity .addorout view:nth-child(1):active {
  transform: scale(0.96);
}

/* 取消按钮 */
.select-identity .addorout view:nth-child(2) {
  width: 180rpx;
  background: #f1f2f6;
  color: #999;
  padding: 28rpx 0;
  border-radius: 18rpx;
  text-align: center;
  font-size: 30rpx;
  transition: 0.15s;
}

/* 点击缩放 */
.select-identity .addorout view:nth-child(2):active {
  transform: scale(0.96);
}
.form-tip {
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
  background-color: #e8f9e8;
  border-left: 8rpx solid #07c160;
  border-radius: 16rpx;

  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;

  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { 
    opacity: 0; 
    transform: translateY(-10rpx); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0); 
  }
}

/* e===================================== */
/* 缩小后的 header（即你提供的尺寸） */
.header.collapsed {
  padding: 86rpx 34rpx 168rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  justify-content: flex-start;
}

.hello {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.18;
  transition: font-size 0.5s ease;
}

.header.collapsed .hello {
  font-size: 56rpx;
}

.location {
  margin-top: 6rpx;
  opacity: 0;
  height: 0;
  font-size: 26rpx;
  transition: opacity 0.5s ease;
}

.header.collapsed .location {
  opacity: 0;
}

/* 身份选择区 */
.role-selection {
  margin-top: 40rpx;
  display: flex;
  gap: 40rpx;
  transition: opacity 0.5s ease;
}

.role-selection.hidden {
  opacity: 0;
  pointer-events: none;
}

.role-selection button {
  background: #fff;
  color: #635bff;
  font-weight: bold;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 通知铃铛 */
.bell {
  width: 60rpx;
  height: 60rpx;
  background: #ffffff33;
  border-radius: 20rpx;
  position: relative;
}

.red-dot {
  background: #ff3b30;
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}

/* 四宫格卡片 */
.grid-box {
  position: relative;
  z-index: 3;
  margin-top: -84rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.grid-item {
  background: #fff;
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.06);
  opacity: 0;
  transform: translateY(-50rpx);
  transition: all 0.5s ease;
}

.grid-item.visible {
  opacity: 1;
  transform: translateY(0);
}

.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.purple { background: linear-gradient(135deg, #82a7ff 0%, #5b78f6 100%); }
.green { background: linear-gradient(135deg, #47de84 0%, #67dce6 100%); }
.orange { background: linear-gradient(135deg, #ffbe3d 0%, #f29d15 100%); }
.red { background: #ef4444; }

.grid-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f3142;
}

.grid-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #767b92;
}

/* 首页三入口新布局：突出课程安排主入口，并将简历相关入口合并为一组 */
.primary-panel {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 22rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #5d53ff 0%, #6f5bff 46%, #9174ff 100%);
  box-shadow: 0 20rpx 40rpx rgba(99, 91, 255, 0.2);
  color: #fff;
}

.primary-panel::before {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -24rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0) 70%);
}

.panel-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
  color: rgba(255, 243, 191, 0.96);
  margin-bottom: 28rpx;
}

.panel-chip::before {
  content: '★';
  margin-right: 10rpx;
  font-size: 22rpx;
}

.panel-main {
  display: flex;
  align-items: center;
}

.primary-icon {
  width: 94rpx;
  height: 94rpx;
  margin-right: 24rpx;
  margin-bottom: 0;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(49, 194, 167, 0.24);
}

.primary-icon-symbol {
  font-size: 64rpx;
  line-height: 1;
  font-weight: 300;
  color: #ffffff;
}

.primary-copy {
  flex: 1;
}

.primary-title {
  font-size: 34rpx;
  color: #fff;
}

.primary-sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 30rpx;
  line-height: 1.45;
}

.panel-arrow {
  margin-top: 28rpx;
  height: 72rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6458ff;
  font-size: 32rpx;
  font-weight: 600;
}

.panel-arrow-icon {
  margin-left: 14rpx;
  font-size: 38rpx;
  line-height: 1;
}

/* 首页主入口补充说明：直接展示入口适用场景和进入后的操作内容 */
.primary-detail-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
