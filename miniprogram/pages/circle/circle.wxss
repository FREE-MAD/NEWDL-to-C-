/* pages/circle/circle.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.category-nav {
  background: white;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin: 0 10rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 24rpx;
  background: #f0f0f0;
}

.category-item.active {
  background: #007AFF;
  color: white;
}

.post-list {
  padding: 20rpx;
}

.post-item {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.follow-btn {
  width: 120rpx;
  height: 56rpx;
  border: 1px solid #007AFF;
  background: white;
  color: #007AFF;
  border-radius: 28rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

.follow-btn.following {
  background: #007AFF;
  color: white;
}

.post-content {
  margin-bottom: 16rpx;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 16rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.image-item.single {
  width: 100%;
  max-height: 400rpx;
}

.image-item.double {
  width: calc(50% - 4rpx);
  height: 200rpx;
}

.image-item.multiple {
  width: calc(33.333% - 6rpx);
  height: 120rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  object-fit: cover;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag-item {
  color: #007AFF;
  font-size: 26rpx;
  padding: 4rpx 0;
}

.post-location {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.location-icon {
  margin-right: 8rpx;
}

.location-text {
  flex: 1;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #f8f9fa;
}

.action-item.liked {
  background: #ffebee;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.loading-more, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.publish-btn {
  position: fixed;
  bottom: 140rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  background: #007AFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,122,255,0.3);
  z-index: 1000;
}

.publish-icon {
  font-size: 40rpx;
  color: white;
}