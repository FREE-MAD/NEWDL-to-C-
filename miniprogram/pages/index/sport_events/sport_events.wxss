/* pages/index/sport_events/sport_events.wxss */
.page {
  background: #f6f7fb;
  min-height: 100vh;
}

/* 顶部区域 */
.hero {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 80rpx;
  color: #fff;
  text-align: center;
}

.hero-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 分类标签 */
.category-tabs {
  background: #fff;
  margin: -40rpx 30rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.tabs {
  display: flex;
  padding: 20rpx 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
  transition: all 0.3s ease;
}

.tab.active {
  color: #667eea;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}

/* 搜索区域 */
.search-section {
  margin: 0 30rpx 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
  border: none;
}

/* 事件列表 */
.events-list {
  padding: 0 30rpx;
}

.event-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.event-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

.event-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.event-info {
  padding: 30rpx;
}

.event-category {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #fff;
}

.event-category.competition {
  background: #ff6b6b;
}

.event-category.training {
  background: #4ecdc4;
}

.event-category.activity {
  background: #45b7d1;
}

.event-category.news {
  background: #96ceb4;
}

.event-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.event-meta {
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
}

.event-stats {
  display: flex;
  gap: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.stat-icon {
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
}

.stat-icon.hot {
  width: 24rpx;
  height: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}

/* 详情模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  max-height: 500rpx;
  overflow-y: auto;
}

.detail-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.detail-info {
  padding: 30rpx;
}

.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.detail-meta {
  margin-bottom: 30rpx;
}

.detail-meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.detail-meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.detail-description {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
  margin-bottom: 40rpx;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
}

.btn-favorite, .btn-share, .btn-join {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
}

.btn-favorite {
  background: #f5f5f5;
  color: #666;
}

.btn-favorite.favorited {
  background: #ff6b6b;
  color: #fff;
}

.btn-share {
  background: #f0f9ff;
  color: #0369a1;
}

.btn-join {
  background: #667eea;
  color: #fff;
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
}