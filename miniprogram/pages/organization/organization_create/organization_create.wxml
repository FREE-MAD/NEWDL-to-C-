<!--
  机构创建与加入 - 外壳
  hero / auth / tab-bar 由本页渲染，表单 UI 全部由两个组件承载：
    - organizationCreate_baseinformation：A 创建机构（TAB_CREATE）
    - organizationCreate_coachaddorganization：B 教练加入（TAB_JOIN）
  两个组件用 hidden 切换显示，认证状态通过 property 下传。
-->
<view class="organization-create-page">
  <view class="hero-card">
    <view class="hero-badge">机构创建与加入</view>
    <view class="hero-title">默认先做自由教练，机构身份从这里正式进入</view>
    <view class="hero-desc">创建机构成功后自动成为机构管理层；填写邀请码加入成功后才成为机构执行教练。</view>
  </view>

  <view class="auth-card">
    <view class="auth-title">认证校验</view>
    <view class="auth-status {{authReady ? 'auth-status-ready' : 'auth-status-blocked'}}">{{authStatusText}}</view>
    <view class="auth-tip">{{authTipText}}</view>
    <view wx:if="{{!authReady}}" class="auth-action" bindtap="goToProfileCertification">去完成教练认证</view>
  </view>

  <view class="tab-bar">
    <view
      wx:for="{{tabList}}"
      wx:key="key"
      class="tab-item {{currentTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <organization-create-baseinformation
    id="baseinformation"
    hidden="{{currentTab !== 'create'}}"
    auth-ready="{{authReady}}"
    profile="{{profile}}"
    initial-mode="{{initialMode}}"
  ></organization-create-baseinformation>

  <organization-create-coachaddorganization
    id="coachaddorganization"
    hidden="{{currentTab !== 'join'}}"
    auth-ready="{{authReady}}"
    profile="{{profile}}"
  ></organization-create-coachaddorganization>
</view>
