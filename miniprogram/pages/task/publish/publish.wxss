/* 弹窗样式 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.modal-container {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.small-modal-container {
  max-width: 620rpx;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-content {
  padding: 30rpx;
}

.modal-footer {
  padding: 24rpx 30rpx 30rpx;
}

.btn-cancel,
.modal-submit {
  flex: 1;
  width: auto;
  height: 88rpx;
  line-height: 88rpx;
}

/* Loading Mask */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.9);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--primary-light);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 新增：教练接取码卡片样式。
   整体视觉沿用 collaboration-card，但强调「码块 + 动作区」，
   让发布者一眼看懂 8 位班级码 / 4 位确认码 / 12 位完整接取码之间的关系。
*/
.pickup-code-card {
  margin-top: 24rpx;
  border: 2rpx solid rgba(25, 118, 210, 0.18);
  background: linear-gradient(135deg, #f7fbff 0%, #ffffff 60%);
  box-shadow: 0 8rpx 24rpx rgba(25, 118, 210, 0.06);
}
.pickup-code-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.section-card-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.section-card-tag-success {
  background: #e8f5e9;
  color: #2e7d32;
}
.section-card-tag-warn {
  background: #fff5e0;
  color: #b26a00;
}
.pickup-code-subtitle {
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c6b7a;
  margin: 12rpx 0 20rpx;
}
.pickup-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f7fafc;
  margin-bottom: 14rpx;
}
.pickup-code-full-row {
  background: #1976d2;
  color: #fff;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}
.pickup-code-label {
  font-size: 24rpx;
  color: #7d8b99;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.pickup-code-full-row .pickup-code-label {
  color: rgba(255, 255, 255, 0.8);
}
.pickup-code-value {
  font-family: Consolas, Monaco, "Courier New", monospace;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-size: 30rpx;
  color: #1c2b3a;
  text-align: right;
}
.pickup-full-code-value {
  color: #fff;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}
.pickup-course-code {
  color: #1565c0;
}
.pickup-confirm-code {
  color: #e65100;
}
.pickup-code-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  /* 修复点击无反应：给动作容器建立定位上下文 + 更高 z-index，
     防止被协作卡片或 scroll-view 内部的伪透明层吞掉触控事件。 */
  position: relative;
  z-index: 2;
}
.pickup-btn {
  flex: 1 1 auto;
  min-width: 40%;
  border-radius: 14rpx;
  font-size: 26rpx;
  /* 修复点击无反应：原来 padding: 0 14rpx 导致按钮垂直方向没有触控余量，
     手指很难精准点中（视觉字高只有 ~47rpx ≈ 23px），统一改为上下 20rpx，
     保证最小触控高度在 80rpx ≈ 40px，符合移动端可点击区域下限。 */
  padding: 20rpx 20rpx;
  line-height: 1.5;
  border: none;
  /* 修复点击无反应：显式允许 pointer 事件，防止父级/全局样式意外禁用。 */
  pointer-events: auto;
}
.pickup-btn::after {
  border: none;
}
.pickup-btn-primary {
  background: #1976d2;
  color: #fff;
}
.pickup-btn-warn {
  background: #ff8f00;
  color: #fff;
}
.pickup-btn-sub {
  background: #eef3f8;
  color: #455a64;
}
/* 新增：第一步「完成课程信息编辑，允许教练接单」的醒目标题级按钮：
   用高饱和绿色背景 + 白色字体，强调它是生成 12 位接取码前的强制前置动作。 */
.pickup-btn-strong {
  background: #00a870;
  color: #fff;
  font-weight: 600;
}
/* 新增：还没 mark_ready 前，生成 12 位接取码的按钮用灰色禁用态，提醒先做上一步。 */
.pickup-btn-disabled {
  background: #c9d3dc !important;
  color: #ffffff !important;
}
/* 新增：接取码卡片内两个操作区（资料确认 / 接取码生成）之间的细分割线。 */
.pickup-divider {
  height: 2rpx;
  background: #e6ecf1;
  margin: 26rpx 0 22rpx;
}
/* 新增：第一步「课程资料确认」的独立分段，样式和外层卡片保持统一。 */
.pickup-info-ready-section {
  padding: 6rpx 2rpx 2rpx;
  /* 修复点击无反应：建立定位上下文 + z-index，确保其内的按钮不会被上方
     collaboration-card 或其他绝对/浮动元素覆盖，触控事件可以落在按钮上。 */
  position: relative;
  z-index: 3;
  /* 修复点击无反应：显式允许 pointer 事件，防止被父级样式继承导致整段不可点。 */
  pointer-events: auto;
}
.pickup-info-ready-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #263238;
  margin-bottom: 10rpx;
}
.pickup-info-ready-desc {
  font-size: 24rpx;
  color: #546e7a;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
.pickup-ready-time {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9aa9;
}
.pickup-code-meta {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #dde6ee;
}
.pickup-meta-row {
  display: block;
  font-size: 24rpx;
  color: #455a64;
  line-height: 1.8;
}
.pickup-code-tip {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8a9aa9;
  line-height: 1.7;
  padding: 14rpx 16rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}
