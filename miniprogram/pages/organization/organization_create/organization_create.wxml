<!--
  机构创建与加入 - 外壳
  完整 UI（hero / auth / tab-bar / 创建表单 / 加入表单）全部由两个组件承载：
    - organizationCreate_baseinformation：A 创建机构（TAB_CREATE）
    - organizationCreate_coachaddorganization：B 教练加入（TAB_JOIN）
  本页仅用 hidden 切换两个组件的显示，tab 切换由组件 triggerEvent('switchTab') 驱动。
-->
<organization-create-baseinformation
  id="baseinformation"
  hidden="{{currentTab !== 'create'}}"
  initial-mode="{{initialMode}}"
  bind:switchTab="onTabTap"
></organization-create-baseinformation>

<organization-create-coachaddorganization
  id="coachaddorganization"
  hidden="{{currentTab !== 'join'}}"
  bind:switchTab="onTabTap"
></organization-create-coachaddorganization>
