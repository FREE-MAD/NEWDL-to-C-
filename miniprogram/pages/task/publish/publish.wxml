<!-- ============================================================
  publish 页面（壳）：顶部 Tab + 流转 tab + 三个表单组件 + 课节管理弹窗
  拆分说明（2026-09-20）：原 selectedTab === 'create'/'summary'/'close' 的内容
  已分别迁移到 publish_classcreate / publish_dailysummary / publish_classoff 组件。
  本页面只保留顶部 Tab、流转 tab（说明 Banner/协作码/接取码/权限卡）、
  课节管理弹窗，并通过 properties 下发数据、通过 bind 接收组件事件。
  ============================================================ -->
<view class="page-container">
  <!-- 顶部安全占位 (配合自定义导航或状态栏) -->
  <view class="status-bar-placeholder" style="height: {{topSafe}}px"></view>

  <!-- 共享信息区：跨 tab 展示流转状态与课程基本信息（从流转 tab 迁移） -->
  <view class="shared-info-bar">
    <!-- 1. 流转状态：权限说明卡 + 流转进度条 -->
    <view wx:if="{{orderId && pagePermissionRows.length}}" class="publish-role-card">
      <view class="publish-role-card-title">{{pageAccessLabel}}</view>
      <view class="flow-progress">
        <view class="flow-progress-step {{flowProgressStep > 1 ? 'done' : (flowProgressStep === 1 ? 'active' : '')}}">
          <view class="flow-progress-dot">{{flowProgressStep > 1 ? '✓' : '1'}}</view>
          <text class="flow-progress-label">编辑课程信息</text>
        </view>
        <view class="flow-progress-line {{flowProgressStep > 1 ? 'done' : ''}}"></view>
        <view class="flow-progress-step {{flowProgressStep > 2 ? 'done' : (flowProgressStep === 2 ? 'active' : '')}}">
          <view class="flow-progress-dot">{{flowProgressStep > 2 ? '✓' : '2'}}</view>
          <text class="flow-progress-label">等待教练接单</text>
        </view>
        <view class="flow-progress-line {{flowProgressStep > 2 ? 'done' : ''}}"></view>
        <view class="flow-progress-step {{flowProgressStep === 3 ? 'active' : ''}}">
          <view class="flow-progress-dot">3</view>
          <text class="flow-progress-label">教练执行课程</text>
        </view>
      </view>
      <view class="publish-role-row" wx:for="{{pagePermissionRows}}" wx:key="label">
        <text class="publish-role-label">{{item.label}}</text>
        <text class="publish-role-value">{{item.value}}</text>
      </view>
    </view>

    <!-- 2. 课程基本信息：协作参考信息（已回填/已关联） -->
    <view class="collaboration-preview" wx:if="{{collaborationMatchedOrderId}}">
      <view class="collaboration-preview-title">已参考协作信息（已回填表单，仅供复用）</view>
      <text class="collaboration-preview-item">课程码：{{collaborationCode}}</text>
      <text class="collaboration-preview-item" wx:if="{{collaborationParentName}}">家长：{{collaborationParentName}}</text>
      <text class="collaboration-preview-item">孩子数量：{{collaborationChildCount || 0}} 个</text>
      <text class="collaboration-preview-item" wx:if="{{collaborationLocationText}}">上课地点：{{collaborationLocationText}}</text>
      <text class="collaboration-preview-item" wx:if="{{collaborationContactText}}">联系方式：{{collaborationContactText}}</text>
      <text class="collaboration-preview-tip">参考完成后，继续修改标题、计划和内部备注，确认后发布新课程。</text>
    </view>
    <view class="collaboration-preview collaboration-preview-readonly" wx:if="{{orderId && !collaborationMatchedOrderId && collaborationCode}}">
      <view class="collaboration-preview-title">已关联协作信息</view>
      <text class="collaboration-preview-item">课程码：{{collaborationCode}}</text>
      <text class="collaboration-preview-tip">编辑态下协作信息已锁定；如需修改关联，请先在班级管理页关闭或删除后再建课。</text>
    </view>
  </view>

  <!-- 顶部 Tab 导航 -->
  <view class="tabs-header">
    <view class="tab-item {{selectedTab === 'flow' ? 'active' : ''}} {{orderId && !canViewFlowTab ? 'disabled' : ''}}" data-tab="flow" bindtap="switchTab">
      <text>流转</text>
      <view class="tab-indicator"></view>
    </view>
    <view class="tab-item {{selectedTab === 'create' ? 'active' : ''}} {{orderId && !canViewCreateTab ? 'disabled' : ''}}" data-tab="create" bindtap="switchTab">
      <text>创建班课程</text>
      <view class="tab-indicator"></view>
    </view>
    <view class="tab-item {{selectedTab === 'summary' ? 'active' : ''}} {{orderId && !canViewSummaryTab ? 'disabled' : ''}}" data-tab="summary" bindtap="switchTab">
      <text>每日总结</text>
      <view class="tab-indicator"></view>
    </view>
    <view class="tab-item {{selectedTab === 'close' ? 'active' : ''}} {{orderId && !canViewCloseTab ? 'disabled' : ''}}" bindtap="handleCloseCourseTab">
      <text>结课</text>
      <view class="tab-indicator"></view>
    </view>
  </view>

  <!-- 主要内容区：不用 scroll-view，让页面自身滚动 -->
  <view class="main-scroll">

    <view class="content-section fade-in">

      <!-- 【创建班课程】tab：迁移为 publish_classcreate 组件 -->
      <view wx:if="{{selectedTab === 'create'}}">
        <publish-classcreate
          order="{{order}}"
          order-id="{{orderId}}"
          is-edit-mode="{{isEditMode}}"
          can-edit-course-info="{{canEditCourseInfo}}"
          can-delete-course="{{canDeleteCourse}}"
          can-adjust-lesson-plan="{{canAdjustLessonPlan}}"
          lesson-plan-locked="{{lessonPlanLocked}}"
          has-generated-pickup-code="{{hasGeneratedPickupCode}}"
          confirm-publish-loading="{{confirmPublishLoading}}"
          collaboration-form-data="{{collaborationFormData}}"
          collaboration-trace="{{collaborationTrace}}"
          bind:submitted="onCreateSubmitted"
          bind:publish-ready="onPublishReady"
          bind:confirm-publish-loading="onConfirmPublishLoading"
          bind:course-deleted="onCourseDeleted"
          bind:open-set-total-modal="onOpenSetTotalModal"
          bind:open-sync-modal="onOpenSyncModal"
        />
      </view>

      <!-- 【流转】tab：保留在父页面（说明 Banner + 协作码 + 权限卡 + 接取码） -->
      <view wx:if="{{selectedTab === 'flow'}}">
        <view class="banner-box {{showBannerBoxExpanded ? '' : 'collapsed'}}">
          <view class="banner-box-header" bindtap="toggleBannerBox">
            <text class="banner-box-title">{{orderId ? '课程管理说明' : '创建课程说明'}}</text>
            <text class="banner-box-status">{{showBannerBoxExpanded ? '默认5秒收起' : '点击展开'}}</text>
          </view>
          <view class="banner-box-body">
            <view class="banner-content">
              <view class="guide-title">{{orderId ? '课程管理' : '创建课程'}}</view>
              <block wx:if="{{!orderId}}">
                <view class="guide-row">
                  <text class="guide-label">当前状态</text>
                  <text class="guide-value">尚未建课，课节管理/每日总结等创建后开启。</text>
                </view>
                <view class="guide-row">
                  <text class="guide-label">需要完成</text>
                  <text class="guide-value">填写课程基础信息、学员信息与内部备注，即可创建班级。</text>
                </view>
                <text class="banner-tip">红色 * 为必填，其余信息用于补充展示。</text>
              </block>
              <block wx:if="{{orderId}}">
                <view class="guide-row">
                  <text class="guide-label">当前状态</text>
                  <text class="guide-value">班级已创建，可进行课节管理与每日总结。</text>
                </view>
                <view class="guide-row">
                  <text class="guide-label">接下来</text>
                  <text class="guide-value">按授课情况安排课节，并及时记录每日训练总结。</text>
                </view>
                <text class="banner-tip">课程信息仍可完善，课节与每日总结将作为教学记录保留。</text>
              </block>
            </view>
          </view>
          <view wx:if="{{orderId}}" class="banner-important-action">
            <text class="banner-action-tip">创建完成后，进入家长展示页把课程内容展示给家长。</text>
            <button class="banner-action-btn" bindtap="handleToProgressDisplay">进入家长展示页</button>
          </view>
        </view>

        <!-- 协作单参考卡 -->
        <view class="section-card collaboration-card collaboration-card-hint {{collaborationCardLocked ? 'collaboration-card-locked' : ''}}">
          <view class="section-card-title collaboration-title-hint">
            <text class="collaboration-title-icon">✦</text>
            快速参考已有协作单
            <text wx:if="{{collaborationCardLocked}}" class="section-card-tag-locked">已锁定</text>
          </view>
          <view class="collaboration-subtitle-hint">
            <text class="collaboration-subtitle-bullet">›</text>
            <text class="collaboration-subtitle-text">辅助入口：从 B 约课单快速复制信息。B 家长约课后，请直接去【课程管理/进度】列表找对应班级编辑。</text>
          </view>
          <view class="collaboration-quick-row">
            <button class="collaboration-quick-btn" bindtap="goCollaborationQuickProgress">去班级管理 / 进度</button>
            <text class="collaboration-quick-tip">主流程推荐从这里进入班级编辑</text>
          </view>
          <view class="collaboration-divider-hint" wx:if="{{!collaborationCardLocked}}">
            <text class="collaboration-divider-label">或仍想快速复制 B 约课信息 →</text>
          </view>
          <view class="collaboration-input-row {{collaborationCardLocked ? 'collaboration-input-row-locked' : ''}}">
            <input
              class="form-input collaboration-code-input {{collaborationCardLocked ? 'collaboration-code-input-locked' : ''}}"
              placeholder="请输入家长课程码"
              placeholder-class="input-placeholder"
              value="{{collaborationCode}}"
              bindinput="handleCollaborationCodeInput"
              bindconfirm="pullCollaborativeOrder"
              disabled="{{collaborationCardLocked}}"
            />
            <button
              class="collaboration-fetch-btn collaboration-fetch-btn-hint {{collaborationCardLocked ? 'collaboration-fetch-btn-locked' : ''}}"
              bindtap="pullCollaborativeOrder"
              loading="{{collaborationLoading}}"
              disabled="{{collaborationCardLocked || collaborationLoading}}"
            >{{collaborationCardLocked ? '已导入参考信息' : '参考该协作单'}}</button>
          </view>
          <!-- collaboration-preview 已迁移至顶部共享信息区 shared-info-bar -->
        </view>

        <!-- publish-role-card 已迁移至顶部共享信息区 shared-info-bar -->

        <!-- 教练接取码展示卡 -->
        <view wx:if="{{orderId && pickupCourseCode}}" class="section-card pickup-code-card">
          <view class="section-card-title pickup-code-title">
            <text class="collaboration-title-icon">✦</text>
            教练接取码
            <text wx:if="{{assignedCoachName}}" class="section-card-tag section-card-tag-success">已被「{{assignedCoachName}}」接取</text>
            <text wx:elif="{{displayPickupCode || pickupFullCode}}" class="section-card-tag section-card-tag-warn">待执行教练接取</text>
            <text wx:else class="section-card-tag section-card-tag-warn">待管理层确认生成</text>
          </view>
          <view class="pickup-code-subtitle">
            {{(displayPickupCode || pickupFullCode) ? (canOperatePickupCode ? '完整接取码已生成。复制发给执行教练，他在首页【接取课程】输入后只是提交接取申请，需你在下方「接取申请待确认」卡片确认后才算接取成功。' : '执行教练视角，仅展示接取结果，不可改码。') : (canOperatePickupCode ? '接取码尚未生成：到「创建班课程」tab 点「完成创建，允许接单」后才会生成，再复制发给执行教练。' : '尚未生成接取码，等待管理层点「完成创建，允许接单」后生成。')}}
          </view>
          <view wx:if="{{displayPickupCode}}" class="pickup-code-row pickup-code-full-row">
            <view class="pickup-code-label">完整接取码（{{displayPickupCode.length}} 位，复制这串）</view>
            <view class="pickup-code-value pickup-full-code-value">
              <text class="pickup-full-left">{{displayPickupCode}}</text>
            </view>
          </view>
          <view wx:if="{{canOperatePickupCode && (displayPickupCode || pickupFullCode)}}" class="pickup-code-actions">
            <button class="pickup-btn pickup-btn-primary" catchtap="onCopyPickupFullCode">复制完整接取码</button>
          </view>
          <view wx:if="{{!canOperatePickupCode}}" class="pickup-readonly-tip">执行教练只读视角；接取码生成与换码由管理层处理。</view>
          <view wx:if="{{assignedCoachName}}" class="pickup-code-meta">
            <text class="pickup-meta-row">接取教练：{{assignedCoachName}}</text>
            <text class="pickup-meta-row" wx:if="{{assignedCoachAt}}">接取时间：{{assignedCoachAt}}</text>
          </view>
          <view wx:else class="pickup-code-tip">
            提示：若接取码发错人，请联系系统管理员处理换码操作。
          </view>
        </view>

        <!-- 【2026-09-21 新流程·接取需管理确认】绑定申请卡片（管理者视角）-->
        <!-- 渲染条件：当前用户是管理者 + 课程处于 awaiting 态 + 有 pending 申请；
             列出所有 pending 申请，提供「确认接取 / 拒绝」按钮，调 handleConfirmBinding / handleRejectBinding。 -->
        <view wx:if="{{hasPendingCoachRequest && canConfirmCoachBinding}}" class="section-card binding-request-card">
          <view class="section-card-title binding-request-title">
            <text class="collaboration-title-icon">✦</text>
            接取申请待确认
            <text class="section-card-tag section-card-tag-warn">{{pendingCoachRequestCount}} 个待处理</text>
          </view>
          <view class="binding-request-subtitle">
            执行教练在首页输入了接取码，按新流程需管理者在这里确认后才会真正写入「已接取」状态。请核对申请人信息后处理。
          </view>
          <view class="binding-request-item" wx:for="{{pendingCoachBindingRequests}}" wx:key="requestId" wx:for-item="req">
            <view class="binding-request-row">
              <text class="binding-request-label">申请人</text>
              <text class="binding-request-value">{{req.coachNameText}}</text>
            </view>
            <view class="binding-request-row" wx:if="{{req.coachUserId}}">
              <text class="binding-request-label">用户标识</text>
              <text class="binding-request-value">{{req.coachUserId}}</text>
            </view>
            <view class="binding-request-row" wx:if="{{req.requestedAtText}}">
              <text class="binding-request-label">申请时间</text>
              <text class="binding-request-value">{{req.requestedAtText}}</text>
            </view>
            <view class="binding-request-actions">
              <button
                class="pickup-btn pickup-btn-primary"
                catchtap="handleConfirmBinding"
                data-request-id="{{req.requestId}}"
                loading="{{coachBindingActionLoading}}"
                disabled="{{coachBindingActionLoading}}"
              >确认接取</button>
              <button
                class="pickup-btn pickup-btn-secondary"
                catchtap="handleRejectBinding"
                data-request-id="{{req.requestId}}"
                loading="{{coachBindingActionLoading}}"
                disabled="{{coachBindingActionLoading}}"
              >拒绝</button>
            </view>
          </view>
        </view>

        <!-- 【2026-09-21 新流程】教练视角 · 自己的申请待确认时单独提示 -->
        <!-- 渲染条件：当前用户在 pending 列表里（myPendingRequest 存在）+ 不是管理者（不能自己确认自己）；
             教练在此看到「等待管理者确认」即可，按钮由管理者侧卡片处理。 -->
        <view wx:if="{{myPendingRequest && !canConfirmCoachBinding}}" class="section-card my-pending-request-card">
          <view class="section-card-title my-pending-request-title">
            <text class="collaboration-title-icon">✦</text>
            你的接取申请已提交
            <text class="section-card-tag section-card-tag-warn">待管理者确认</text>
          </view>
          <view class="my-pending-request-subtitle">
            管理者确认后，本课程会自动进入「进行中」状态，你就可以在「每日总结」tab 填写训练总结了。若被拒绝，可重新提交接取码。
          </view>
          <view class="my-pending-request-meta" wx:if="{{myPendingRequest.requestedAtText}}">
            <text class="my-pending-request-meta-row">提交时间：{{myPendingRequest.requestedAtText}}</text>
          </view>
        </view>
      </view>

      <!-- 【每日总结】tab：迁移为 publish_dailysummary 组件 -->
      <view wx:if="{{selectedTab === 'summary'}}">
        <publish-dailysummary
          order-id="{{orderId}}"
          schedule="{{schedule}}"
          display-schedule="{{displaySchedule}}"
          can-write-summary="{{canWriteSummary}}"
          order-progress="{{order}}"
          bind:summary-saved="onSummarySaved"
          bind:lesson-completed="onLessonCompleted"
        />
      </view>

      <!-- 【结课】tab：迁移为 publish_classoff 组件 -->
      <view wx:if="{{selectedTab === 'close'}}">
        <publish-classoff
          order-id="{{orderId}}"
          can-close-course="{{canCloseCourse}}"
          initial-close-summary="{{closeSummaryInput}}"
          initial-close-coach-note="{{closeCoachNoteInput}}"
          bind:course-closed="onCourseClosed"
        />
      </view>

      <!-- 底部垫高，防止内容被遮挡 -->
      <view class="footer-spacer"></view>
    </view>
  </view>

  <!-- 课节管理弹窗（保留在父页面，由 classcreate 组件通过事件触发打开） -->
  <view class="modal-mask" wx:if="{{showSetTotalModal}}">
    <view class="modal-container small-modal-container">
      <view class="modal-header">设置总课时</view>
      <view class="modal-content">
        <view class="form-item">
          <text class="form-label">总课时</text>
          <input class="form-input" type="number" value="{{setTotalLessonsInput}}" placeholder="例如 10" bindinput="handleSetTotalLessonsInput" />
        </view>
        <view class="sync-note no-margin">适用：全新班级，无历史课节。保存后一次性生成第 1 到第 N 课的课节框。</view>
        <view class="sync-note strong-warning">重要：累计记录满 3 节课后自动锁定，不再支持重新设置总课时，避免覆盖已有明细。</view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeSetTotalModal">取消</button>
        <button class="btn-submit modal-submit" bindtap="submitSetTotalLessons">保存</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showSyncModal}}">
    <view class="modal-container">
      <view class="modal-header">半途接入课程</view>
      <view class="modal-content">
        <view class="form-item">
          <text class="form-label">总课时</text>
          <input class="form-input" type="number" value="{{syncTotalLessonsInput}}" placeholder="请输入总课时" bindinput="handleSyncTotalLessonsInput" />
        </view>
        <view class="form-item">
          <text class="form-label">前面已上了几节课</text>
          <input class="form-input" type="number" value="{{syncHistoryCountInput}}" placeholder="例如 6" bindinput="handleSyncHistoryCountInput" />
        </view>
        <view class="sync-note">适用：前面已上过一部分，现在从中间接入系统管理。例：总 10、已上 6 → 先显示 0-6 历史汇总，再生成第 7-10 课。</view>
        <view class="sync-note strong-warning">重要：历史课次不计锁定；接入后累计记录满 3 节课自动锁定，不再支持改总课时或补录历史。</view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeSyncModal">取消</button>
        <button class="btn-submit modal-submit" bindtap="submitSyncLessonProgress">保存</button>
      </view>
    </view>
  </view>

  <!-- 全屏加载遮罩 -->
  <view class="loading-mask" wx:if="{{showCover}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>

</view>
