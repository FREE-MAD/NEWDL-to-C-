/* pages/index/hot/hot.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-actions {
  display: flex;
  align-items: center;
}

.search-btn {
  font-size: 32rpx;
  padding: 8rpx;
}

.category-nav {
  background: white;
  display: flex;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.category-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
  position: relative;
}

.category-item.active {
  color: #007AFF;
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #007AFF;
  border-radius: 2rpx;
}

.hot-list {
  padding: 20rpx;
}

/* 热门话题样式 */
.hot-topic-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.topic-rank {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
  min-width: 40rpx;
  text-align: center;
}

.topic-content {
  flex: 1;
}

.topic-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.topic-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: block;
}

.topic-stats {
  display: flex;
  gap: 20rpx;
}

.topic-stats .stat-item {
  font-size: 24rpx;
  color: #999;
}

.topic-trend {
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}

.topic-trend.up {
  color: #4CAF50;
  background: #e8f5e8;
}

.topic-trend.down {
  color: #f44336;
  background: #ffebee;
}

.topic-trend.stable {
  color: #666;
  background: #f5f5f5;
}

/* 热门用户样式 */
.hot-user-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.user-rank {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
  min-width: 40rpx;
  text-align: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.user-bio {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: block;
}

.user-stats {
  display: flex;
  gap: 16rpx;
}

.user-stats .stat-item {
  font-size: 22rpx;
  color: #999;
}

.follow-btn {
  width: 120rpx;
  height: 56rpx;
  background: #007AFF;
  color: white;
  border: none;
  border-radius: 28rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

.follow-btn.following {
  background: white;
  color: #007AFF;
  border: 1px solid #007AFF;
}

/* 热门动态样式 */
.hot-post-item {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  display: flex;
}

.post-rank {
  font-size: 24rpx;
  font-weight: bold;
  margin: 16rpx;
  min-width: 30rpx;
  text-align: center;
  color: #666;
}

.post-content {
  flex: 1;
  padding: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.post-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.post-username {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.post-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.post-image {
  margin-bottom: 12rpx;
}

.post-image image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

.post-stats {
  display: flex;
  gap: 24rpx;
}

.stat-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-btn.liked {
  color: #ff4757;
}

.stat-icon {
  font-size: 24rpx;
}

.stat-text {
  font-size: 22rpx;
  color: #666;
}

/* 热门赛事样式 */
.hot-event-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.event-rank {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
  min-width: 40rpx;
  text-align: center;
}

.event-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  object-fit: cover;
}

.event-info {
  flex: 1;
}

.event-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.event-stats {
  display: flex;
  gap: 16rpx;
}

.event-stats .stat-item {
  font-size: 22rpx;
  color: #999;
}

.event-status {
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  white-space: nowrap;
}

.event-status.upcoming {
  color: #4CAF50;
  background: #e8f5e8;
}

.event-status.ongoing {
  color: #ff9800;
  background: #fff3e0;
}

.event-status.ended {
  color: #999;
  background: #f5f5f5;
}

.loading, .empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  display: block;
}