<view class="page">
  <view class="header">
  <view class="header-info">
    <view class="city">保持微笑</view>

    <view class="stats">
      
    </view>

    <view class="edit-btn">
      记录心情
      <text class="edit-icon">✎</text>
    </view>
  </view>
</view>

<!-- Tabs -->
<view class="tab-card">
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:for-item="item"
      wx:for-index="index"
      wx:key="status"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>
</view>

    <!-- 新增操作说明：直接说明课程管理页展示什么，以及两个操作入口分别负责什么 -->
<view class="flow-tip-card {{showFlowTipCard ? '' : 'collapsed'}}">
  <!-- 新增标题栏点击展开/收起：默认 5 秒自动收起，收起后仍可点标题重新展开 -->
  <view class="flow-tip-header" bindtap="toggleFlowTipCard">
    <text class="flow-tip-title">课程管理页面说明</text>
    <text class="flow-tip-status">{{showFlowTipCard ? '默认5秒收起' : '点击展开'}}</text>
  </view>
  <!-- 课程管理说明内容：展开时完整显示，5 秒后切到折叠态而不是直接移除 -->
  <view class="flow-tip-body">
    <view class="flow-guide-row">
          <text class="flow-guide-label">这里展示什么</text>
          <text class="flow-guide-value">这里展示您已经创建的全部班级。</text>
    </view>
    <view class="flow-guide-row">
          <text class="flow-guide-label">班级展示</text>
          <text class="flow-guide-value">进入班级展示页面，用于查看班级信息及课程内容。该页面主要功能是分享给家长，供家长查看。</text>
    </view>
    <view class="flow-guide-row">
          <text class="flow-guide-label">班级管理</text>
          <text class="flow-guide-value">进入班级管理页面，用于进行课程管理、每日总结等班级相关操作。</text>
        </view>
        <view class="flow-guide-row">
          <text class="flow-guide-label">怎么选</text>
          <text class="flow-guide-value">您可以根据当前需要，直接选择对应班级的“班级展示”或“班级管理”。</text>
    </view>
  </view>
</view>

<!-- Task List -->
<view class="list">

  <view
    wx:for="{{tasks}}"
    wx:for-item="item"
    wx:key="id"
    class="card"
  >

    <!-- Header -->
    <view class="card-header">
      <text class="title">{{item.title}}</text>
      <view class="status status-{{item.status}}">
        {{item.statusText}}
      </view>
    </view>

    <!-- Meta -->
    <view class="meta">
      <text>{{item.category}}</text>
      <text>📍 {{item.location}}</text>
      <text>进度 {{item.progressText}}</text>
    </view>

    <!-- Desc -->
    <view class="desc">{{item.description}}</view>

    <!-- Action -->
    <view class="action-row">
      <button
        class="{{item.canManageClass ? 'secondary' : 'primary'}}"
        bindtap="onViewDetail"
        data-id="{{item.id}}"
      >
              班级展示
      </button>
      <button
        wx:if="{{item.canManageClass}}"
        class="primary"
        bindtap="onManageClass"
        data-id="{{item.id}}"
      >
              班级管理
      </button>
    </view>

  </view>

  <!-- Empty -->
  <view wx:if="{{tasks.length === 0}}" class="empty">
    <text class="icon">📋</text>
    <text>暂无{{tabs[currentTab].label}}的任务</text>
  </view>

</view>

</view>
