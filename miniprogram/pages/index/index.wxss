  box-shadow: 0 12rpx 30rpx rgba(97, 98, 122, 0.08);
}

.resume-group-head {
  margin-bottom: 22rpx;
}

.resume-group-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d3142;
}

.resume-group-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8e92a5;
}

.resume-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx;
