<!-- pages/demand/manage/manage.wxml -->
<view class="container">
  
  <!-- Top Category Switch -->
  <view class="category-switch">
    <view 
      class="category-btn {{currentCategory === 'public' ? 'active' : ''}}" 
      bindtap="switchCategory" 
      data-category="public"
    >
      大众健身练
    </view>
    <view 
      class="category-btn {{currentCategory === 'coach' ? 'active' : ''}}" 
      bindtap="switchCategory" 
      data-category="coach"
    >
      教练跟踪练
    </view>
  </view>

  <!-- Content Area -->
  <view class="content-area">
    
    <!-- Mass Fitness Practice List -->
    <block wx:if="{{currentCategory === 'public'}}">
      <view class="section-title">大众健身精选</view>
      <view class="exercise-list">
        <block wx:for="{{publicExercises}}" wx:key="id">
          <view class="exercise-card" bindtap="onExerciseDetail" data-id="{{item.id}}">
            <view class="card-image-placeholder">
               <!-- Placeholder for image -->
               <text>🏋️</text>
            </view>
            <view class="card-info">
              <view class="card-title">{{item.title}}</view>
              <view class="card-desc">{{item.desc}}</view>
              <view class="card-meta">
                <text class="tag difficulty">{{item.difficulty}}</text>
                <text class="tag duration">⏱ {{item.duration}} 分钟</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </block>

    <!-- Coach Tracking Practice List -->
    <block wx:if="{{currentCategory === 'coach'}}">
      <view class="section-title">我的教练计划</view>
      <view class="coach-list">
        <block wx:if="{{coachExercises.length === 0}}">
          <view class="empty-state">
            <text>暂无教练分配的练习</text>
            <text class="sub-text">下单后教练会为您制定专属计划</text>
          </view>
        </block>
        <block wx:else>
          <block wx:for="{{coachExercises}}" wx:key="id">
            <view class="coach-card" bindtap="onExerciseDetail" data-id="{{item.id}}">
              <view class="coach-header">
                <text class="coach-name">👨‍🏫 {{item.coachName}}</text>
                <text class="assign-date">{{item.assignDate}}</text>
              </view>
              <view class="coach-body">
                <view class="coach-title">{{item.title}}</view>
                <view class="coach-desc">{{item.desc}}</view>
              </view>
              <view class="coach-footer">
                <text class="status-tag {{item.status}}">
                  {{item.status === 'completed' ? '已完成' : '待完成'}}
                </text>
                <view class="action-arrow">查看详情 ></view>
              </view>
            </view>
          </block>
        </block>
      </view>
    </block>

  </view>

</view>
