<view class="container">
  <view class="select-identity">
    <!-- 0身份选择 -->
    <view class="id_select">
      <view>
        1.请选择你的身份
      </view>
      <view class="{{role==='C' ? 'active' : ''}}" data-role="C" bindtap="chooseRole">我是教练</view>
      <!-- MVP: P 侧登录入口已下线，当前仅提供 C / V 身份 -->
      <view class="{{role==='V' ? 'active' : ''}}" data-role="V" bindtap="chooseRole">我是访客</view>
    </view>
    <!-- 1与2只可以选一个,绑定事件,3必选 -->
    <!-- 1自动采集 -->
    <view class="getxx">
      <view class="getxx_head">
        2.请补充你的基本信息
      </view>
      <view class="Automatic">
        <!-- 勾选框 -->
        <!-- <checkbox value="agree_1">我同意自动采集</checkbox> -->
        <checkbox-group bindchange="onAutoChange">
          <checkbox value="auto" checked="{{autoSelected}}">我同意自动采集</checkbox>
        </checkbox-group>

        <button class="wx-login-btn" wx:if="{{autoSelected}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{isSubmitting}}" loading="{{isSubmitting}}">
          <image class="wx-icon" src="/images/wx-icon.png"></image>
          <text>微信一键登录</text>
        </button>
      </view>
      <!-- 2手动输入 -->
      <view class="Artificial">
        <!-- 头像选择 -->
        <view class="avatar-section">

          <view class="manual-label">我倾向与手动输入</view>
          <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar" src="{{avatarUrl || '/images/icons/avatar.png'}}"></image>
          </button>
          <text class="avatar-tip">点击选择头像</text>
        </view>

        <!-- <input placeholder="昵称"/>
    <input placeholder="联系方式"/> -->
        <input placeholder="昵称" value="{{nickname}}" bindinput="onNickname" />
        <input placeholder="联系方式" value="{{phone}}" bindinput="onPhone" />
        <input placeholder="详细地址" value="{{address}}" disabled="true" bindtap="chooseLocation" />
      </view>
    </view>
    <!-- 3协议通过 -->
    <view class="Agreement" bindchange="onAgreeChange">
      <checkbox-group bindchange="onAgreeChange">
        <checkbox value="agree" checked="{{agreeProtocol}}">我同意协议</checkbox>
      </checkbox-group>
    </view>
    <!-- 4提交取消 -->
    <view class="addorout">
      <button type="primary" bindtap="finishExpanded" data-addorout="addorout" disabled="{{isSubmitting}}" loading="{{isSubmitting}}">
        提交
      </button>
      <view bindtap="cancelManual">× 取消</view>
    </view>
  </view>
</view>
